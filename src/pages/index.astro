---
// src/pages/index.astro
export const prerender = false;

// Security layer: If a user already has an active session cookie, route them directly to the dashboard
const sessionCookie = Astro.cookies.get("user_session");
if (sessionCookie && sessionCookie.value.trim() !== "") {
  return Astro.redirect('/dashboard');
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Portal Access</title>
		<style>
			body {
				margin: 0;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				background: linear-gradient(135deg, #2575fc 0%, #6a11cb 100%);
				font-family: Arial, sans-serif;
				color: #fff;
				padding: 20px;
				box-sizing: border-box;
				overflow-x: hidden;
			}

			/* Perspective Container for 3D Flipping */
			.auth-wrapper {
				perspective: 1000px;
				width: 100%;
				max-width: 420px;
				height: 550px;
			}

			/* Card Body supporting dual sides */
			.auth-card {
				width: 100%;
				height: 100%;
				position: relative;
				transform-style: preserve-3d;
				transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
			}

			/* Active state to switch faces */
			.auth-wrapper.flipped .auth-card {
				transform: rotateY(180deg);
			}

			/* Shareable Glass Style Rules */
			.glass-face {
				position: absolute;
				width: 100%;
				height: 100%;
				backface-visibility: hidden;
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				padding: 40px;
				border-radius: 25px;
				box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
				border: 1px solid rgba(255, 255, 255, 0.15);
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.register-face {
				transform: rotateY(180deg);
			}

			h2 {
				margin: 0 0 5px 0;
				font-size: 26px;
				font-weight: bold;
				text-align: center;
			}

			.subtitle {
				font-size: 13px;
				color: rgba(255, 255, 255, 0.7);
				text-align: center;
				margin-bottom: 25px;
			}

			.form-group {
				margin-bottom: 16px;
				position: relative;
			}

			label {
				font-size: 11px;
				font-weight: bold;
				display: block;
				margin-bottom: 5px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			input {
				width: 100%;
				padding: 12px 16px;
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-radius: 20px;
				background: rgba(255, 255, 255, 0.15);
				color: #fff;
				outline: none;
				box-sizing: border-box;
				font-size: 14px;
				transition: border-color 0.2s, background-color 0.2s;
			}

			input:focus {
				border-color: #fff;
				background: rgba(255, 255, 255, 0.25);
			}

			/* Password Layout Wrapper for Mask Control */
			.password-wrapper {
				position: relative;
			}
			
			.password-wrapper input {
				padding-right: 45px;
			}

			.toggle-password {
				position: absolute;
				right: 15px;
				top: 50%;
				transform: translateY(-50%);
				background: transparent;
				border: none;
				color: rgba(255, 255, 255, 0.6);
				cursor: pointer;
				font-size: 14px;
				padding: 0;
			}
			
			.toggle-password:hover {
				color: #fff;
			}

			button[type="submit"] {
				width: 100%;
				padding: 12px;
				border-radius: 20px;
				cursor: pointer;
				font-weight: bold;
				border: none;
				font-size: 15px;
				background: #fff;
				color: #6a11cb;
				margin-top: 10px;
				box-shadow: 0 4px 15px rgba(0,0,0,0.1);
				transition: transform 0.1s, opacity 0.2s;
			}

			button[type="submit"]:active {
				transform: scale(0.98);
			}
			
			button[type="submit"]:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.switch-prompt {
				text-align: center;
				font-size: 13px;
				margin-top: 20px;
				color: rgba(255, 255, 255, 0.8);
			}

			.switch-link {
				color: #fff;
				font-weight: bold;
				text-decoration: none;
				cursor: pointer;
				margin-left: 5px;
			}

			.switch-link:hover {
				text-decoration: underline;
			}

			.error-banner {
				background: rgba(255, 75, 92, 0.2);
				border: 1px solid #ff4b5c;
				padding: 10px;
				border-radius: 12px;
				font-size: 12px;
				text-align: center;
				margin-bottom: 15px;
				display: none;
			}
			/* Real-time Indicator Input States */
input.is-valid {
	border-color: #2ecc71 !important;
	background: rgba(46, 204, 113, 0.15) !important;
}

input.is-invalid {
	border-color: #e74c3c !important;
	background: rgba(231, 76, 60, 0.15) !important;
}

/* Validation Feedback Messaging */
.validation-msg {
	font-size: 11px;
	margin-top: 4px;
	font-weight: 500;
	display: block;
	min-height: 14px;
	opacity: 0;
	transform: translateY(-3px);
	transition: opacity 0.2s ease, transform 0.2s ease;
}

.validation-msg.error-active {
	color: #ff7675;
	opacity: 1;
	transform: translateY(0);
}

.validation-msg.success-active {
	color: #55efc4;
	opacity: 1;
	transform: translateY(0);
}

		</style>
	</head>

	<body>
		<div class="auth-wrapper" id="authWrapper">
			<div class="auth-card">
				
				<!-- SIDE A: SECURE LOGIN INTERFACE -->
<div class="glass-face login-face">
	<h2>Welcome Back</h2>
	<p class="subtitle">Enter your credentials to access your station</p>
	
	<div class="error-banner" id="loginError"></div>

	<form id="loginForm" novalidate>
		<!-- 1. Login Username Field -->
		<div class="form-group">
			<label>Username</label>
			<input type="text" id="loginUsername" name="username" required autocomplete="username" placeholder="Enter your username" />
			<div class="validation-msg" id="msgLoginUsername"></div>
		</div>

		<!-- 2. Login Password Field -->
		<div class="form-group">
			<label>Password</label>
			<div class="password-wrapper">
				<input type="password" id="loginPassword" name="password" required autocomplete="current-password" placeholder="Enter your password" />
				<button type="button" class="toggle-password" aria-label="Toggle password visibility">👁️</button>
			</div>
			<div class="validation-msg" id="msgLoginPassword"></div>
		</div>
		<button type="submit">Log In</button>
	</form>

	<p class="switch-prompt">
		Don't have an account? 
		<span class="switch-link" id="toRegister">Sign Up</span>
	</p>
</div>


		<!-- SIDE B: SECURE REGISTRATION INTERFACE -->
<div class="glass-face register-face">
	<h2>Create Account</h2>
	<p class="subtitle">Register a secure identity footprint</p>
	
	<div class="error-banner" id="registerError"></div>

	<form id="registerForm" novalidate>
		<!-- 1. Display Name Field -->
		<div class="form-group">
			<label>Display Name</label>
			<input type="text" id="regDisplayName" name="displayName" required placeholder="e.g. Alex Mercer" />
			<div class="validation-msg" id="msgDisplayName"></div>
		</div>
		
		<!-- 2. Username Field -->
		<div class="form-group">
			<label>Username</label>
			<input type="text" id="regUsername" name="username" required minlength="3" maxlength="20" placeholder="Letters, numbers, underscores" />
			<div class="validation-msg" id="msgUsername"></div>
		</div>

		<!-- 3. Password Field -->
		<div class="form-group">
			<label>Choose Password</label>
			<div class="password-wrapper">
				<input type="password" id="regPassword" name="password" required minlength="6" placeholder="At least 6 characters" />
				<button type="button" class="toggle-password" aria-label="Toggle password visibility">👁️</button>
			</div>
			<div class="validation-msg" id="msgPassword"></div>
		</div>
		<button type="submit" id="regSubmitBtn">Register Station</button>
	</form>

	<p class="switch-prompt">
		Already configured? 
		<span class="switch-link" id="toLogin">Log In</span>
	</p>
</div>

</div>
</div>


		<!-- UI CONTROLLER SCRIPTS -->
		<script>
			const wrapper = document.getElementById("authWrapper");
			const toRegisterBtn = document.getElementById("toRegister");
			const toLoginBtn = document.getElementById("toLogin");

			// 1. Flip Animations Card Toggle Context
			toRegisterBtn?.addEventListener("click", () => wrapper?.classList.add("flipped"));
			toLoginBtn?.addEventListener("click", () => wrapper?.classList.remove("flipped"));

			// 2. Interactive Mask Control Show/Hide Eye Action
			document.querySelectorAll(".toggle-password").forEach(btn => {
				btn.addEventListener("click", () => {
					const input = btn.previousElementSibling as HTMLInputElement | null;
					if (!input) return;
					if (input.type === "password") {
						input.type = "text";
						btn.textContent = "🙈";
					} else {
						input.type = "password";
						btn.textContent = "👁️";
					}
				});
			});

			// 3. Form API Hooks Wireframes
			const loginForm = document.getElementById("loginForm") as HTMLFormElement | null;
			const registerForm = document.getElementById("registerForm") as HTMLFormElement | null;
			const loginError = document.getElementById("loginError");
			const registerError = document.getElementById("registerError");

			// Login Execution
			loginForm?.addEventListener("submit", async (e) => {
				e.preventDefault();
				if (!loginError) return;
				loginError.style.display = "none";

				const formData = new FormData(loginForm);
				try {
					const res = await fetch('/login-api', { method: 'POST', body: formData });
					const data = await res.json();
					if (data.success) {
						window.location.href = '/dashboard';
					} else {
						loginError.textContent = data.message || "Invalid authentication parameters.";
						loginError.style.display = "block";
					}
				} catch {
					loginError.textContent = "Gateway authentication network error.";
					loginError.style.display = "block";
				}
			});

			// Select Login Elements
const logForm = document.getElementById("loginForm") as HTMLFormElement | null;
const loginUsernameInput = document.getElementById("loginUsername") as HTMLInputElement | null;
const loginPasswordInput = document.getElementById("loginPassword") as HTMLInputElement | null;

// Login Validation Message Hooks
const msgLoginUsername = document.getElementById("msgLoginUsername");
const msgLoginPassword = document.getElementById("msgLoginPassword");

// 1. Monitor Login Username Typing
loginUsernameInput?.addEventListener("input", () => {
	const val = loginUsernameInput.value.trim();
	if (val.length === 0) {
		setIndicator(loginUsernameInput, msgLoginUsername, false, "Username is required.");
	} else if (val.length < 3) {
		setIndicator(loginUsernameInput, msgLoginUsername, false, "Username must be at least 3 characters.");
	} else {
		setIndicator(loginUsernameInput, msgLoginUsername, true, "", "Format looks valid.");
	}
});

// 2. Monitor Login Password Typing
loginPasswordInput?.addEventListener("input", () => {
	const val = loginPasswordInput.value;
	if (val.length === 0) {
		setIndicator(loginPasswordInput, msgLoginPassword, false, "Password is required.");
	} else if (val.length < 6) {
		setIndicator(loginPasswordInput, msgLoginPassword, false, "Password must be at least 6 characters.");
	} else {
		setIndicator(loginPasswordInput, msgLoginPassword, true, "", "Ready to verify.");
	}
});

// Intercept Login submission to block transaction if active errors exist
logForm?.addEventListener("submit", (e) => {
	// Re-trigger validation checks for blank submissions
	if (!loginUsernameInput?.value.trim()) {
		setIndicator(loginUsernameInput, msgLoginUsername, false, "Username is required.");
	}
	if (!loginPasswordInput?.value) {
		setIndicator(loginPasswordInput, msgLoginPassword, false, "Password is required.");
	}

	const hasErrors = logForm.querySelectorAll(".is-invalid").length > 0;
	if (hasErrors) {
		e.preventDefault();
		e.stopImmediatePropagation();
		alert("Please enter your credentials completely before submitting.");
	}
});

			// Registration Execution
			registerForm?.addEventListener("submit", async (e) => {
				e.preventDefault();
				if (!registerError) return;
				registerError.style.display = "none";

				const formData = new FormData(registerForm);
				try {
					const res = await fetch('/register-api', { method: 'POST', body: formData });
					const data = await res.json();
					if (data.success) {
						alert("Identity registered successfully! Logging you in...");
						window.location.href = '/dashboard';
					} else {
						registerError.textContent = data.message || "Registration parameter conflict.";
						registerError.style.display = "block";
					}
				} catch {
					registerError.textContent = "Gateway registration network error.";
					registerError.style.display = "block";
				}
			});

			// Select Registration Elements
const regForm = document.getElementById("registerForm") as HTMLFormElement | null;
const regDisplayName = document.getElementById("regDisplayName") as HTMLInputElement | null;
const regUsername = document.getElementById("regUsername") as HTMLInputElement | null;
const regPassword = document.getElementById("regPassword") as HTMLInputElement | null;

// Validation Message Hooks
const msgDisplayName = document.getElementById("msgDisplayName");
const msgUsername = document.getElementById("msgUsername");
const msgPassword = document.getElementById("msgPassword");

// Helper function to render visual indicator status
function setIndicator(input: HTMLInputElement | null, msgEl: HTMLElement | null, isValid: boolean, errorMsg: string = "", successMsg: string = "") {
	if (!input || !msgEl) return;

	if (isValid) {
		input.classList.remove("is-invalid");
		input.classList.add("is-valid");
		msgEl.textContent = successMsg;
		msgEl.classList.remove("error-active");
		msgEl.classList.add("success-active");
	} else {
		input.classList.remove("is-valid");
		input.classList.add("is-invalid");
		msgEl.textContent = errorMsg;
		msgEl.classList.remove("success-active");
		msgEl.classList.add("error-active");
	}
}

// 1. Monitor Display Name Typing
regDisplayName?.addEventListener("input", () => {
	const val = regDisplayName.value.trim();
	if (val.length >= 2) {
		setIndicator(regDisplayName, msgDisplayName, true, "", "Looks great!");
	} else {
		setIndicator(regDisplayName, msgDisplayName, false, "Name must be at least 2 characters.");
	}
});

// 2. Monitor Username Constraints (Letters, numbers, underscores only)
regUsername?.addEventListener("input", () => {
	const val = regUsername.value.trim();
	const usernameRegex = /^[a-zA-Z0-9_]+$/;

	if (val.length === 0) {
		setIndicator(regUsername, msgUsername, false, "Username is required.");
	} else if (val.length < 3) {
		setIndicator(regUsername, msgUsername, false, "Must be at least 3 characters.");
	} else if (!usernameRegex.test(val)) {
		setIndicator(regUsername, msgUsername, false, "Only letters, numbers, and underscores allowed.");
	} else {
		setIndicator(regUsername, msgUsername, true, "", "Username format is valid!");
	}
});

// 3. Monitor Password Complexity length check
regPassword?.addEventListener("input", () => {
	const val = regPassword.value;
	if (val.length >= 6) {
		setIndicator(regPassword, msgPassword, true, "", "Secure length achieved.");
	} else {
		setIndicator(regPassword, msgPassword, false, "Password must be at least 6 characters.");
	}
});

// Intercept form submission to block transaction if active errors exist
regForm?.addEventListener("submit", (e) => {
	const hasErrors = regForm.querySelectorAll(".is-invalid").length > 0;
	const fieldsFilled = regDisplayName?.value && regUsername?.value && regPassword?.value;

	if (hasErrors || !fieldsFilled) {
		e.preventDefault();
		e.stopImmediatePropagation();
		alert("Please clear all invalid input fields before executing registration.");
	}
});

		</script>
	</body>
</html>



			if (contentCounter) contentCounter.textContent = "(0 / 120)";
			
			// Inside your addNoteForm data.success code path block, update innerHTML string to include drawer skeleton:
skeletonCard.innerHTML = `
	<div class="note-controls">
		<label class="note-selection-control">

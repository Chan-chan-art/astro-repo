<script>
	// ==========================================
	// 1. GLOBAL SCOPE UTILITY FUNCTIONS FIRST
	// ==========================================
	
	// Secure escape helper to prevent cross-site script injections (XSS)
	function escapeHTML(str: string): string {
		return str.replace(/[&<>'"]/g, 
			tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
		);
	}

	// Re-binding listener to attach smooth delete animations to newly added cards
	function attachDeleteListener(btn: Element | null) {
		if (!btn) return;
		btn.addEventListener("click", async () => {
			const id = btn.getAttribute("data-id");
			const cardItem = btn.closest(".note-item");
			if (!id || !cardItem) return;

			if (confirm("Move this note to Trash? You can restore it within 30 days.")) {
				try {
					cardItem.classList.add("removing");
					const res = await fetch(`/notes-api?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
					const data = await res.json();
					if (res.ok && data.success) {
						if (data.warning) showNotificationToast(data.warning, true);
						setTimeout(() => {
							cardItem.remove();
							updateDashboardStatistics();
							const remainingCards = document.querySelectorAll(".note-item");
							if (remainingCards.length === 0) {
								window.location.reload();
							}
						}, 300);
					} else {
						cardItem.classList.remove("removing");
						showNotificationToast(data.message || "Failed to move note to Trash.", true);
					}
				} catch (error) {
					console.error("Unable to move note to Trash.", error);
					cardItem.classList.remove("removing");
					showNotificationToast("Unable to move note to Trash. Please try again.", true);
				}
			}
		});
	}

	async function handleTrashCardAction(button: HTMLButtonElement, action: "restore" | "delete") {
		const noteId = button.dataset.id;
		const card = getNoteCard(button);
		if (!noteId || !card) return;
		if (action === "delete" && !confirm("Permanently delete this note? This cannot be undone.")) return;

		button.disabled = true;
		try {
			const response = await fetch(
				action === "restore"
					? "/trash-api"
					: `/trash-api?id=${encodeURIComponent(noteId)}`,
				action === "restore"
					? {
						method: "PUT",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ action: "restore", id: noteId })
					}
					: { method: "DELETE" }
			);
			const data = await response.json();
			if (!response.ok || !data.success) {
				throw new Error(data.message || `Unable to ${action} this note.`);
			}

			if (data.warning) showNotificationToast(data.warning, true);
			card.classList.add("removing");
			window.setTimeout(() => {
				card.remove();
				if (document.querySelectorAll(".notes-grid .note-item").length === 0) {
					window.location.reload();
				}
			}, 300);
			showNotificationToast(action === "restore" ? "Note restored to My Notes." : "Note permanently deleted.");
		} catch (error) {
			console.error(`Unable to ${action} trashed note.`, error);
			showNotificationToast(error instanceof Error ? error.message : `Unable to ${action} this note.`, true);
		} finally {
			button.disabled = false;
		}
	}

	function getNoteCard(element: Element | null): HTMLElement | null {
		return element?.closest<HTMLElement>(".note-item") || null;
	}

	function getSelectedNoteCards(): HTMLElement[] {
		return Array.from(document.querySelectorAll<HTMLInputElement>("[data-bulk-select-note]:checked"))
			.map((checkbox) => getNoteCard(checkbox))
			.filter((card): card is HTMLElement => card !== null);
	}

	function updateBulkActionsBar() {
		const bar = document.getElementById("bulkActionsBar");
		const count = document.getElementById("bulkSelectionCount");
		if (!bar) return;

		const selectedCards = getSelectedNoteCards();
		const hasEnoughNotes = selectedCards.length >= 2;
		const tooManyNotes = selectedCards.length > 100;
		const allOwned = selectedCards.every((card) => card.dataset.userRole === "owner");
		bar.hidden = !hasEnoughNotes;
		if (count) count.textContent = `${selectedCards.length} selected`;

		bar.querySelectorAll<HTMLButtonElement>("[data-bulk-action]").forEach((button) => {
			const ownerOnly = button.dataset.bulkAction === "reminder" || button.dataset.bulkAction === "trash";
			button.disabled = !hasEnoughNotes || tooManyNotes || (ownerOnly && !allOwned);
			button.title = tooManyNotes
				? "Select no more than 100 notes at a time."
				: ownerOnly && !allOwned
					? "This action is available only when all selected notes belong to you."
					: "";
		});
	}

	async function performBulkNoteAction(
		action: "pin" | "favorite" | "reminder" | "trash",
		details: { date?: string; time?: string } = {},
		submitButton: HTMLButtonElement | null = null,
		status: HTMLElement | null = null
	) {
		const selectedCards = getSelectedNoteCards();
		if (selectedCards.length < 2 || selectedCards.length > 100) {
			showNotificationToast("Select between 2 and 100 notes for a bulk action.", true);
			return;
		}

		const noteIds = selectedCards.map((card) => card.dataset.id || "");
		if (noteIds.some((id) => !id) || new Set(noteIds).size !== noteIds.length) {
			showNotificationToast("One or more selected notes could not be identified.", true);
			return;
		}
		if ((action === "reminder" || action === "trash") &&
			selectedCards.some((card) => card.dataset.userRole !== "owner")) {
			showNotificationToast("This action is available only for notes you own.", true);
			return;
		}
		if (action === "trash" &&
			!window.confirm(`Move ${selectedCards.length} selected notes to Trash? You can restore them within 30 days.`)) {
			return;
		}

		const bar = document.getElementById("bulkActionsBar");
		const barButtons = Array.from(bar?.querySelectorAll<HTMLButtonElement>("button") || []);
		const selectionInputs = Array.from(document.querySelectorAll<HTMLInputElement>("[data-bulk-select-note]"));
		barButtons.forEach((button) => { button.disabled = true; });
		selectionInputs.forEach((input) => { input.disabled = true; });
		if (submitButton) submitButton.disabled = true;
		if (status) {
			status.hidden = true;
			status.textContent = "";
		}

		try {
			const response = await fetch("/bulk-notes-api", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ action, ids: noteIds, ...details })
			});
			const data = await response.json();
			if (!response.ok || !data.success) {
				throw new Error(data.message || "Unable to apply this action to the selected notes.");
			}

			const affectedCount = Number(data.affectedCount);
			const count = Number.isSafeInteger(affectedCount) && affectedCount > 0
				? affectedCount
				: noteIds.length;
			const message = action === "pin"
				? `Pinned ${count} notes.`
				: action === "favorite"
					? `Added ${count} notes to Favorites.`
					: action === "reminder"
						? `Set reminders for ${count} notes.`
						: `Moved ${count} notes to Trash.`;
			if (action === "reminder") {
				(document.getElementById("bulkReminderDialog") as HTMLDialogElement | null)?.close();
			}
			showNotificationToast(message);
			window.setTimeout(() => window.location.reload(), 800);
		} catch (error) {
			console.error("Bulk note action failed.", error);
			const message = error instanceof Error
				? error.message
				: "Unable to apply this action to the selected notes.";
			if (status) {
				status.textContent = message;
				status.hidden = false;
			} else {
				showNotificationToast(message, true);
			}
		} finally {
			barButtons.forEach((button) => { button.disabled = false; });
			selectionInputs.forEach((input) => { input.disabled = false; });
			if (submitButton) submitButton.disabled = false;
			updateBulkActionsBar();
		}
	}


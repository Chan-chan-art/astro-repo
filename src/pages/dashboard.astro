function attachCommentToggleListener(btn: Element | null) {
	if (!btn) return;
	btn.addEventListener("click", async () => {
		const noteId = btn.getAttribute("data-id");
		if (!noteId) return;

		const drawer = document.getElementById(`drawer-${noteId}`);
		if (!drawer) return;

		const isOpen = drawer.classList.toggle("drawer-open");
		btn.setAttribute("aria-expanded", String(isOpen));

		if (isOpen) {
			const loaded = await fetchAndRenderComments(noteId);
			if (loaded && await markCommentsRead(noteId)) {

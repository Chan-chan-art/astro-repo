type NoteRecipientActivity = {
	username: string;
	is_active: number | string | boolean;
	last_viewed_at: string | Date | null;
};

async function refreshNoteActivity(noteId: string) {
	const card = document.querySelector<HTMLElement>(`.note-item[data-id="${noteId}"]`);
	if (!card) return;

	let activity = card.querySelector<HTMLElement>("[data-note-activity]");
	if (!activity) {
		const footer = card.querySelector(".note-date")?.parentElement;
		if (!footer) return;
		activity = document.createElement("div");
		activity.className = "note-activity";
		activity.dataset.noteActivity = "";
		activity.dataset.noteId = noteId;
		activity.setAttribute("aria-live", "polite");
		footer.append(activity);
	}

	try {
		const response = await fetch(`/activity-api?noteId=${encodeURIComponent(noteId)}`);
		const result = await response.json();
		if (!response.ok || !result.success || !Array.isArray(result.recipients)) {
			throw new Error(result.message || "Unable to load recipient activity.");
		}

		const recipients = result.recipients as NoteRecipientActivity[];
		activity.replaceChildren();

		const activeRecipients = recipients.filter((recipient) => Number(recipient.is_active) === 1);
		for (const recipient of activeRecipients) {
			const presence = document.createElement("span");
			presence.className = "activity-presence is-active";
			const dot = document.createElement("span");
			dot.className = "activity-presence-dot";
			dot.setAttribute("aria-hidden", "true");
			presence.append(dot, document.createTextNode(`@${recipient.username} active`));
			activity.append(presence);
		}

		const readers = recipients.filter((recipient) => recipient.last_viewed_at);
		if (readers.length > 0) {
			const receipt = document.createElement("span");
			receipt.className = "note-read-receipt";
			receipt.textContent = `👁️ Read by ${readers.map((reader) => `@${reader.username}`).join(", ")}`;
			activity.append(receipt);
		}

		if (activity.childElementCount === 0) {
			activity.textContent = "Waiting for a recipient to come online or view this note.";
		}
	} catch (error) {
		activity.textContent = "Activity unavailable.";
		console.error(`Unable to refresh activity for note ${noteId}.`, error);
	}
}

async function sendPresenceHeartbeat() {
	if (document.visibilityState !== "visible") return;
	try {
		const response = await fetch("/activity-api", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ action: "heartbeat" }),
			keepalive: true
		});
		if (!response.ok) throw new Error("Presence heartbeat was rejected.");
	} catch (error) {
		console.error("Unable to update active presence.", error);
	}
}

async function markSharedNoteViewed(noteId: string, card: HTMLElement) {
	try {
		const response = await fetch("/activity-api", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ action: "view", noteId })
		});
		const result = await response.json();
		if (!response.ok || !result.success) {
			throw new Error(result.message || "Unable to record note view.");
		}
		card.dataset.viewReceiptSent = "true";
	} catch (error) {
		console.error(`Unable to record view receipt for note ${noteId}.`, error);
	}
}

function markVisibleSharedNote(card: HTMLElement) {
	const noteId = card.dataset.id;
	if (!noteId || card.dataset.viewReceiptSent === "true" || document.visibilityState !== "visible") return;

	const bounds = card.getBoundingClientRect();
	const visibleWidth = Math.max(0, Math.min(bounds.right, window.innerWidth) - Math.max(bounds.left, 0));
	const visibleHeight = Math.max(0, Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, 0));
	const visibleRatio = (visibleWidth * visibleHeight) / Math.max(1, bounds.width * bounds.height);
	if (visibleRatio >= 0.5) void markSharedNoteViewed(noteId, card);
}

if ("IntersectionObserver" in window) {
	const sharedNoteObserver = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const card = entry.target as HTMLElement;
			if (entry.isIntersecting && entry.intersectionRatio >= 0.5) markVisibleSharedNote(card);
		}
	}, { threshold: 0.5 });

	document.querySelectorAll<HTMLElement>('.note-item[data-user-role]:not([data-user-role="owner"])')
		.forEach((card) => sharedNoteObserver.observe(card));
} else {
	document.querySelectorAll<HTMLElement>('.note-item[data-user-role]:not([data-user-role="owner"])')
		.forEach((card) => markVisibleSharedNote(card));
}

void sendPresenceHeartbeat();
window.setInterval(() => {
	void sendPresenceHeartbeat();
}, 60_000);
document.addEventListener("visibilitychange", () => {
	if (document.visibilityState === "visible") {
		void sendPresenceHeartbeat();
		document.querySelectorAll<HTMLElement>('.note-item[data-user-role]:not([data-user-role="owner"])')
			.forEach((card) => markVisibleSharedNote(card));
	}
});

document.querySelectorAll<HTMLElement>(".note-activity[data-note-id]").forEach((activity) => {
	const noteId = activity.dataset.noteId;
	if (noteId) void refreshNoteActivity(noteId);
});
window.setInterval(() => {
	if (document.visibilityState !== "visible") return;
	document.querySelectorAll<HTMLElement>(".note-activity[data-note-id]").forEach((activity) => {
		const noteId = activity.dataset.noteId;
		if (noteId) void refreshNoteActivity(noteId);
	});
}, 30_000);

// 🌟 Secure sharing prompt listener helper function
function attachShareListener(btn: Element | null) {
	if (!btn) return;
	btn.addEventListener("click", async () => {
		const noteId = btn.getAttribute("data-id");
		if (!noteId) return;

		// 1. Open an interactive prompt modal input box natively
		const targetFriend = prompt("Enter your friend's exact username to share this note:");
		if (!targetFriend || targetFriend.trim() === "") return;

		try {
			const res = await fetch('/share-api', {
				method: 'POST',
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ noteId, username: targetFriend.trim() })
			});
			const data = await res.json();

			if (res.ok && data.success) {
				// Fire your beautiful emerald toast notification banner
				showNotificationToast("✨ Note shared successfully with " + targetFriend + "!");
				
				// Dynamically inject or update footnote on the fly without a page reload
				const cardItem = btn.closest(".note-item");
				if (cardItem) {
					let footnote = cardItem.querySelector(".note-shared-footnote");
					if (!footnote) {
						const footerDiv = cardItem.querySelector(".note-date")?.parentElement;
						if (footerDiv) {
							footerDiv.insertAdjacentHTML("afterbegin", `
								<div class="note-shared-footnote">
									🔗 Shared with: <span class="footnote-users">@${escapeHTML(targetFriend)}</span>
								</div>
							`);
						}
					} else {
						const usersSpan = footnote.querySelector(".footnote-users");
						if (usersSpan && usersSpan.textContent) {
							usersSpan.textContent += `, @${targetFriend}`;
						}
					}

					const noteId = cardItem.getAttribute("data-id");
					if (noteId) void refreshNoteActivity(noteId);
				}
			} else {
				showNotificationToast("❌ " + (data.message || "Failed to share note."), true);
			}
		} catch (error) {
			console.error("Unable to share note.", error);
			showNotificationToast("❌ Error reaching share execution endpoint.", true);
		}
	});
}

document.querySelectorAll(".btn-share-note").forEach((btn) => attachShareListener(btn));

const themePreferenceSelect = document.getElementById("themePreference") as HTMLSelectElement | null;
const darkModeToggle = document.getElementById("darkModeToggle") as HTMLInputElement | null;
const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");
const themeStorageKey = "notepad-theme-preference";

function applyThemePreference(preference: string, persist: boolean = false) {
	if (preference !== "light" && preference !== "dark" && preference !== "system") return;

	const theme = preference === "system" ? (colorSchemeQuery.matches ? "dark" : "light") : preference;
	document.documentElement.dataset.themePreference = preference;
	document.documentElement.dataset.theme = theme;
	if (themePreferenceSelect) themePreferenceSelect.value = preference;
	if (darkModeToggle) darkModeToggle.checked = theme === "dark";

	if (persist) {
		try {
			localStorage.setItem(themeStorageKey, preference);
		} catch (error) {
			console.error("Unable to save the theme preference.", error);
			showNotificationToast("❌ Theme changed, but the preference could not be saved.", true);
		}
	}
}

applyThemePreference(document.documentElement.dataset.themePreference || "system");

themePreferenceSelect?.addEventListener("change", () => {
	applyThemePreference(themePreferenceSelect.value, true);
});

darkModeToggle?.addEventListener("change", () => {
	applyThemePreference(darkModeToggle.checked ? "dark" : "light", true);
});

colorSchemeQuery.addEventListener("change", () => {
	if (document.documentElement.dataset.themePreference === "system") {
		applyThemePreference("system");
	}
});

type ReminderNotification = { id: number | string; title: string; date: string; time: string };
const notifiedReminderIds = new Set<string>();
let lastReminderCheck = Date.now() - 30000;

async function checkDueReminders() {
	try {
		const response = await fetch("/reminders-api?mode=monitor");
		const data = await response.json();
		if (!response.ok || !data.success || !Array.isArray(data.reminders)) {
			throw new Error(data.message || "Unable to check due reminders.");
		}

		const checkedAt = Date.now();
		for (const reminder of data.reminders as ReminderNotification[]) {
			const reminderId = String(reminder.id);
			const dueAt = new Date(`${reminder.date}T${reminder.time}:00`).getTime();
			if (dueAt > checkedAt || dueAt < lastReminderCheck || notifiedReminderIds.has(reminderId)) continue;

			notifiedReminderIds.add(reminderId);
			const message = `Reminder due: ${reminder.title}`;
			showNotificationToast(message);
			if ("Notification" in window && Notification.permission === "granted") {
				const notification = new Notification("Reminder due", { body: reminder.title });
				notification.onclick = () => window.focus();
			}
		}
		lastReminderCheck = checkedAt;
	} catch (error) {
		console.error("Unable to check due reminders.", error);
	}
}

void checkDueReminders();
window.setInterval(() => void checkDueReminders(), 30000);

</script>

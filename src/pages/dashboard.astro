					</div>
					<p class="note-attachment-status" id="noteAttachmentStatus" aria-live="polite" hidden></p>
					<input type="hidden" id="noteLatitude" name="latitude" />
					<input type="hidden" id="noteLongitude" name="longitude" />
					

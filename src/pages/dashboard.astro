	const selectedPreviewUrls = new WeakMap<HTMLElement, string[]>();

	function setSelectedImagePreviews(container: HTMLElement, files: File[]) {
		for (const url of selectedPreviewUrls.get(container) || []) URL.revokeObjectURL(url);
		container.replaceChildren();

		const previewUrls: string[] = [];
		const imageFiles = files.filter((file) =>
			file.type.startsWith("image/") || /\.(jpe?g|png|gif|webp|heic|heif)$/i.test(file.name)
		);
		for (const file of imageFiles) {
			const src = URL.createObjectURL(file);
			previewUrls.push(src);
			const button = document.createElement("button");
			button.type = "button";
			button.className = "attachment-preview-open";
			button.dataset.previewSrc = src;
			button.dataset.previewDownload = src;
			button.dataset.previewName = file.name;
			button.setAttribute("aria-label", `View ${file.name} full screen`);
			const image = document.createElement("img");
			image.src = src;
			image.alt = `Preview of ${file.name}`;
			button.append(image);
			container.append(button);
		}
		selectedPreviewUrls.set(container, previewUrls);
		applyDashboardStyleScope(container);
	}

	function updateNoteAttachmentStatus() {
		if (!noteAttachmentStatus) return;
		const selectedFiles = [noteFileInput, notePhotoInput, noteCameraInput]
			.flatMap(input => input
				? Array.from(input.files || []).map((file, index) => ({ input, file, index }))
				: []);
		const hasLocation = Boolean(noteLatitudeInput?.value && noteLongitudeInput?.value);
		noteAttachmentStatus.replaceChildren();
		noteAttachmentStatus.hidden = selectedFiles.length === 0 && !hasLocation;
		if (noteAttachmentStatus.hidden) return;

		selectedFiles.forEach(({ input, file, index }) => {
			const item = document.createElement("span");
			item.className = "note-attachment-item";

			const name = document.createElement("span");
			name.className = "note-attachment-name";
			name.textContent = file.name;

			const removeButton = document.createElement("button");
			removeButton.type = "button";
			removeButton.className = "note-attachment-remove";
			removeButton.textContent = "×";
			removeButton.setAttribute("aria-label", `Remove ${file.name}`);
			removeButton.title = `Remove ${file.name}`;
			removeButton.addEventListener("click", () => {
				const remainingFiles = new DataTransfer();
				Array.from(input.files || []).forEach((selectedFile, selectedIndex) => {
					if (selectedIndex !== index) remainingFiles.items.add(selectedFile);
				});
				input.files = remainingFiles.files;
				updateNoteAttachmentStatus();
			});

			item.append(name, removeButton);
			noteAttachmentStatus.append(item);
		});

		if (hasLocation) {
			const latitude = noteLatitudeInput?.value || "";
			const longitude = noteLongitudeInput?.value || "";
			const item = document.createElement("span");
			item.className = "note-attachment-item";
			item.dataset.noteLocationStatus = "true";

			const locationLink = document.createElement("a");
			locationLink.href = `https://www.google.com/maps?q=${encodeURIComponent(`${latitude},${longitude}`)}`;
			locationLink.target = "_blank";
			locationLink.rel = "noopener noreferrer";
			locationLink.textContent = `📍 Exact location: ${latitude}, ${longitude}`;
			item.append(locationLink);

			const removeLocationButton = document.createElement("button");
			removeLocationButton.type = "button";
			removeLocationButton.className = "note-attachment-remove";
			removeLocationButton.textContent = "×";
			removeLocationButton.setAttribute("aria-label", "Remove location attachment");
			removeLocationButton.title = "Remove location attachment";
			removeLocationButton.addEventListener("click", clearNoteLocationSelection);

			item.append(removeLocationButton);
			noteAttachmentStatus.append(item);
		}
	}

	function clearNoteLocationSelection() {
		noteLocationRequestId++;
		if (noteLatitudeInput) noteLatitudeInput.value = "";
		if (noteLongitudeInput) noteLongitudeInput.value = "";
		updateNoteAttachmentStatus();
	}

	function hideNoteLocationStatus() {
		if (!noteAttachmentStatus) return;
		noteAttachmentStatus.querySelector("[data-note-location-status]")?.remove();
		if (noteAttachmentStatus.childElementCount === 0) {
			noteAttachmentStatus.hidden = true;
		}
	}

	document.getElementById("attachFileButton")?.addEventListener("click", () => noteFileInput?.click());
	document.getElementById("attachPhotoButton")?.addEventListener("click", () => notePhotoInput?.click());
	document.getElementById("attachCameraButton")?.addEventListener("click", () => noteCameraInput?.click());
	[noteFileInput, notePhotoInput, noteCameraInput].forEach(input => {
		input?.addEventListener("change", updateNoteAttachmentStatus);
	});

	document.getElementById("attachLocationButton")?.addEventListener("click", () => {
		if (!navigator.geolocation) {
			showNotificationToast("Location is not supported by this browser.", true);
			return;
		}
		const requestId = ++noteLocationRequestId;
		if (noteLatitudeInput) noteLatitudeInput.value = "";
		if (noteLongitudeInput) noteLongitudeInput.value = "";
		updateNoteAttachmentStatus();
		if (noteAttachmentStatus) {
			const item = document.createElement("span");
			item.className = "note-attachment-item";
			item.dataset.noteLocationStatus = "true";

			const statusText = document.createElement("span");
			statusText.className = "note-attachment-name";
			statusText.textContent = "Getting your location…";

			const cancelButton = document.createElement("button");
			cancelButton.type = "button";
			cancelButton.className = "note-attachment-remove";
			cancelButton.textContent = "×";
			cancelButton.setAttribute("aria-label", "Cancel location attachment");
			cancelButton.title = "Cancel location attachment";
			cancelButton.addEventListener("click", clearNoteLocationSelection);

			item.append(statusText, cancelButton);
			noteAttachmentStatus.hidden = false;
			noteAttachmentStatus.append(item);
		}
		navigator.geolocation.getCurrentPosition(
			(position) => {
				if (requestId !== noteLocationRequestId) return;
				if (noteLatitudeInput) noteLatitudeInput.value = String(position.coords.latitude);
				if (noteLongitudeInput) noteLongitudeInput.value = String(position.coords.longitude);
				updateNoteAttachmentStatus();
			},
			(error) => {
				if (requestId !== noteLocationRequestId) return;
				updateNoteAttachmentStatus();
				showNotificationToast(`Could not get location: ${error.message}`, true);
			},
			{ enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
		);
	});

	addNoteForm?.addEventListener("reset", () => {

		.map(({ name }) => name);

	function applyDashboardStyleScope(element: HTMLElement) {
		for (const node of [element, ...Array.from(element.querySelectorAll("*"))]) {
			for (const attribute of dashboardStyleScopeAttributes) {
				node.setAttribute(attribute, "");
			}
		}

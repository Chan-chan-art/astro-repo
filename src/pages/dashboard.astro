	</form>
</div>

			<!-- RIGHT SIDEBAR: INTERACTIVE WORKSPACE NOTEPAD -->
			<div class="glass-card">
				<h2 style="margin-top:0; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom:10px;">📋 Personal Notepad Workspace</h2>
				
				<!-- Live Workspace Filter Query Bar -->
<div class="search-wrapper">
	<span class="search-icon">🔍</span>
	<input 
		type="text" 
		id="workspaceSearch" 
		placeholder="Search notes by title or content instantly..." 
		aria-label="Search workspace notes"
	/>
	<!-- 🌟 ADDED THIS CLEAR BUTTON -->

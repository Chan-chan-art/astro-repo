	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const viewButton = target.closest(".btn-view-note");
		if (viewButton) {
			const card = getNoteCard(viewButton);
			if (card) openNoteView(card);
			return;
		}

		const editButton = target.closest(".btn-edit-note");
		if (editButton) {
			const card = getNoteCard(editButton);
			if (card) openNoteEdit(card);
			return;
		}

		const closeButton = target.closest("[data-close-note-dialog]");
		if (closeButton) {
			closeButton.closest("dialog")?.close();
		}
	});

	document.getElementById("noteEditForm")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.currentTarget as HTMLFormElement;
		const noteId = (form.elements.namedItem("id") as HTMLInputElement).value;
		const title = (form.elements.namedItem("title") as HTMLInputElement).value.trim();
		const content = (form.elements.namedItem("content") as HTMLTextAreaElement).value.trim();
		const category = (form.elements.namedItem("category") as HTMLSelectElement).value;
		const error = document.getElementById("noteEditError");
		const saveButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!noteId || !editingNoteCard) return;

		if (error) {
			error.hidden = true;
			error.textContent = "";
		}
		if (saveButton) saveButton.disabled = true;
		try {
			const response = await fetch(`/notes-api?id=${encodeURIComponent(noteId)}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ title, content, category })
			});
			const data = await response.json();
			if (!response.ok || !data.success) {
				if (error) {
					error.textContent = data.message || "Unable to update this note.";
					error.hidden = false;
				}
				return;
			}

			editingNoteCard.dataset.category = data.category;
			editingNoteCard.querySelector<HTMLElement>("[data-note-category]")!.textContent = data.category;
			editingNoteCard.querySelector<HTMLElement>("[data-note-title]")!.textContent = data.title;
			editingNoteCard.querySelector<HTMLElement>("[data-note-content]")!.textContent = data.content;
			(document.getElementById("noteEditDialog") as HTMLDialogElement).close();
			editingNoteCard = null;
			updateDashboardStatistics();
			updateWorkspaceVisibility();
			showNotificationToast("Note updated successfully.");
		} catch (updateError) {
			console.error("Unable to update note.", updateError);
			if (error) {
				error.textContent = "Unable to reach the note update service. Please try again.";
				error.hidden = false;
			}
		} finally {
			if (saveButton) saveButton.disabled = false;
		}
	});


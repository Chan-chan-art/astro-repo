	if (!targetForm || !targetForm.classList.contains("comment-input-box-row")) return;
	
	e.preventDefault();
	
	const noteId = targetForm.getAttribute("data-note-id");
	const inputField = targetForm.querySelector("input[name='text']") as HTMLInputElement | null;
	const submitButton = targetForm.querySelector("button[type='submit']") as HTMLButtonElement | null;

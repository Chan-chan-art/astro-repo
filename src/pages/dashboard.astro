function updateChatAttachmentStatus(form: HTMLFormElement) {
	const status = form.querySelector<HTMLElement>(".chat-attachment-status");
	if (!status) return;
	const selectedFiles = Array.from(form.querySelectorAll<HTMLInputElement>(".chat-attachment-input"))
		.flatMap(input => Array.from(input.files || []));
	const latitude = form.querySelector<HTMLInputElement>('input[name="latitude"]')?.value;
	const longitude = form.querySelector<HTMLInputElement>('input[name="longitude"]')?.value;
	status.hidden = selectedFiles.length === 0 && !(latitude && longitude);
	setSelectedImagePreviews(status, selectedFiles);
	if (selectedFiles.length > 0) {
		const filenames = document.createElement("span");
		filenames.textContent = selectedFiles.map(file => file.name).join(", ");
		status.prepend(filenames);
	}
	if (latitude && longitude) {
		const locationLink = document.createElement("a");
		locationLink.href = `https://www.google.com/maps?q=${encodeURIComponent(`${latitude},${longitude}`)}`;
		locationLink.target = "_blank";
		locationLink.rel = "noopener noreferrer";
		locationLink.textContent = `📍 Exact location: ${latitude}, ${longitude}`;
		status.append(locationLink);
	}
}


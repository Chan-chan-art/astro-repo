}
/* 🔔 Floating Notification Toast Design specs */
.notification-toast {
	position: fixed;
	top: -70px; /* Positioned entirely off-screen by default */
	left: 50%;
	transform: translateX(-50%);
	background: rgba(46, 204, 113, 0.2); /* Soft emerald green tint */
	backdrop-filter: blur(14px);
	-webkit-backdrop-filter: blur(14px);
	border: 1px solid rgba(46, 204, 113, 0.4);
	color: #fff;
	padding: 14px 28px;
	border-radius: 50px;
	font-weight: bold;
	font-size: 14px;
	display: flex;
	align-items: center;
	gap: 10px;
	box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
	z-index: 9999; /* Guarantees it floats over absolutely all layers */
	transition: top 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s ease;
	opacity: 0;
}

/* Activated dynamic styling flags */
.notification-toast.toast-active {
	top: 30px; /* Slides down comfortably from top window borders */
	opacity: 1;
}

/* Error variations overlay overrides if save logic snaps */
.notification-toast.toast-error {
	background: rgba(231, 76, 60, 0.2);
	border-color: rgba(231, 76, 60, 0.4);
}
/* ✕ Absolute Right-Aligned Search Clear Button */
.btn-clear-search {
	position: absolute;
	right: 14px;
	top: 50%;
	transform: translateY(-50%);
	background: rgba(255, 255, 255, 0.1);
	color: rgba(255, 255, 255, 0.5);
	border: none;
	cursor: pointer;
	font-size: 11px;
	width: 20px;
	height: 20px;
	padding: 0;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background-color 0.2s, color 0.2s, transform 0.2s, opacity 0.2s;
	opacity: 0; /* Hidden by default until user types */
	pointer-events: none;
}

.btn-clear-search.is-visible {
	opacity: 1;
	pointer-events: auto; /* Re-enable click transactions when text exists */
}

.btn-clear-search:hover {
	background: rgba(255, 255, 255, 0.25);
	color: #fff;
	transform: translateY(-50%) scale(1.08);
}
.char-counter {
	font-size: 10px;
	color: rgba(255, 255, 255, 0.4);
	float: right;
	font-weight: normal;
	letter-spacing: 0px;
	transition: color 0.2s ease;
	line-height: 14px; /* Aligns smoothly with field headers */
}
/* 🧹 Profile Reset Action Button Layout */
.btn-clear-profile {
	background: rgba(255, 255, 255, 0.1);
	color: rgba(255, 255, 255, 0.7);
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 20px;
	font-size: 13px;
	font-weight: bold;
	cursor: pointer;
	transition: background-color 0.2s, color 0.2s, transform 0.1s;
}

.btn-clear-profile:hover {
	background: rgba(231, 76, 60, 0.25); /* Fades into a translucent soft alert-red accent on mouse-over */
	border-color: rgba(231, 76, 60, 0.4);
	color: #fff;
}

.btn-clear-profile:active {
	transform: scale(0.96);
}
/* 🏷️ Category Filter Navigation Row Layout */
.category-tabs-bar {

	}

	function localDateKey() {
		const today = new Date();
		return `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
	}

	function announceWorkspaceCountChange(key: string, delta: number) {
		if (delta !== 0) {
			window.dispatchEvent(new CustomEvent("workspace-count-change", { detail: { key, delta } }));
		}

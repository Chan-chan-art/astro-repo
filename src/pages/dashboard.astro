	function sortNoteCards() {
		if (!notesGrid) return;
		const cards = Array.from(notesGrid.querySelectorAll<HTMLElement>(".note-item:not(.note-skeleton)"));
		cards.sort((a, b) => Number(b.dataset.pinned === "true") - Number(a.dataset.pinned === "true"));
		cards.forEach((card) => notesGrid.append(card));
	}

	async function updateNotePreference(button: HTMLButtonElement) {
		const card = getNoteCard(button);
		const noteId = button.dataset.id;
		const preference = button.dataset.preference;
		if (!card || !noteId || (preference !== "pinned" && preference !== "favorite")) return;

		const enabled = card.dataset[preference] !== "true";
		button.disabled = true;
		try {
			const response = await fetch(`/note-preferences-api?noteId=${encodeURIComponent(noteId)}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ preference, enabled })
			});
			const data = await response.json();
			if (!response.ok || !data.success) {
				throw new Error(data.message || "Unable to save this note preference.");
			}

			card.dataset[preference] = String(enabled);
			button.setAttribute("aria-pressed", String(enabled));
			button.classList.toggle("is-active", enabled);
			button.textContent = preference === "pinned"
				? (enabled ? "📌 Unpin" : "📌 Pin")
				: (enabled ? "★ Remove Favorite" : "☆ Favorite");
			if (preference === "pinned") sortNoteCards();
			updateWorkspaceVisibility();
			showNotificationToast(preference === "pinned"
				? (enabled ? "Note pinned." : "Note unpinned.")
				: (enabled ? "Added to Favorites." : "Removed from Favorites."));
		} catch (error) {
			console.error("Unable to update note preference.", error);
			showNotificationToast(error instanceof Error ? error.message : "Unable to save this note preference.", true);
		} finally {
			button.disabled = false;
		}
	}

	document.querySelectorAll<HTMLButtonElement>(".btn-note-preference").forEach((button) => {
		button.addEventListener("click", () => updateNotePreference(button));
	});


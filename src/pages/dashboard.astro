// 🌟 Upgraded Avatar File Preview & Compression System
avatarFileInput?.addEventListener("change", () => {
	const fileList = avatarFileInput.files;
	if (!fileList || fileList.length === 0) return;
	const targetedFile = fileList[0];

	if (!targetedFile.type.startsWith("image/")) {
		alert("Please choose a valid image file configuration (.png, .jpg, .webp).");
		avatarFileInput.value = "";
		return;
	}

	const fileStreamReader = new FileReader();
	fileStreamReader.onload = (event) => {
		const parsedResultString = event.target?.result;
		if (typeof parsedResultString !== "string") return;

		// Create an Image object in memory to compute dimensions
		const img = new Image();
		img.src = parsedResultString;
		img.onload = () => {
			// Initialize a hidden Canvas element
			const canvas = document.createElement("canvas");
			const ctx = canvas.getContext("2d");
			if (!ctx) return;

			// Define maximum bounds for an avatar photo (e.g., 300px width/height is plenty for a profile icon)
			const MAX_WIDTH = 300;
			const MAX_HEIGHT = 300;
			let width = img.width;
			let height = img.height;

			// Calculate scale factors to maintain aspect ratio perfectly
			if (width > height) {
				if (width > MAX_WIDTH) {
					height *= MAX_WIDTH / width;
					width = MAX_WIDTH;
				}
			} else {
				if (height > MAX_HEIGHT) {
					width *= MAX_HEIGHT / height;
					height = MAX_HEIGHT;
				}
			}

			canvas.width = width;
			canvas.height = height;

			// Draw the full image down onto the smaller canvas surface area
			ctx.drawImage(img, 0, 0, width, height);

			// 🌟 COMPRESSION LAYER: Export as a highly compressed JPEG string
			// 0.6 means 60% quality – it reduces file size by up to 90% while keeping it sharp!
			const compressedDataUrl = canvas.toDataURL("image/jpeg", 0.6);

			// 1. Instantly swap the visual avatar circle preview source
			if (avatarPreviewImage) {
				avatarPreviewImage.src = compressedDataUrl;
			}

			// 2. TACTICAL PACKAGING OVERRIDE: 
			// We intercept the multipart file input value on your form and replace it 
			// with our tiny compressed string so 'profile-api.ts' handles a small dataset!
			const hiddenPayloadInput = document.getElementById("compressedAvatarString") as HTMLInputElement | null;
			if (hiddenPayloadInput) {
				hiddenPayloadInput.value = compressedDataUrl;
			}
		};
	};
	fileStreamReader.readAsDataURL(targetedFile);
});



				unreadCommentCounts.delete(noteId);
			}
		}
	});
}

async function fetchAndRenderComments(noteId: string): Promise<boolean> {
	const feed = document.getElementById(`comments-feed-${noteId}`);
	if (!feed) return false;

	try {
		const res = await fetch(`/comments-api?noteId=${encodeURIComponent(noteId)}`);
		const data = await res.json();
		if (!res.ok || !data.success || !Array.isArray(data.comments)) {
			throw new Error(data.message || "Unable to load comments.");
		}

		if (data.comments.length === 0) {
			feed.innerHTML = `<div class="comment-empty-state">💬 No comments yet. Start the conversation!</div>`;
			applyDashboardStyleScope(feed);
			return true;
		}

		feed.innerHTML = data.comments.map((c: any) => {
			const attachmentLinks = (Array.isArray(c.attachments) ? c.attachments : []).map((attachment: any) => {
				if (attachment.attachment_type === "location") {
					const latitude = String(attachment.latitude);
					const longitude = String(attachment.longitude);
					const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${latitude},${longitude}`)}`;
					return `<a class="comment-location-link" href="${mapUrl}" target="_blank" rel="noopener noreferrer" aria-label="Open exact shared location in Google Maps" title="Exact coordinates: ${escapeHTML(latitude)}, ${escapeHTML(longitude)}">📍 Exact location: ${escapeHTML(latitude)}, ${escapeHTML(longitude)}</a>`;
				}
				const icon = attachment.attachment_type === "camera" ? "📷" : attachment.attachment_type === "photo" ? "🖼️" : "📎";
				const name = String(attachment.original_name || "Attachment");
				const id = encodeURIComponent(String(attachment.id));
				const downloadUrl = `/note-attachments-api?commentAttachmentId=${id}`;
				if (String(attachment.mime_type || "").startsWith("image/")) {
					return `<span class="comment-image-attachment"><button type="button" class="attachment-preview-open" data-preview-src="${downloadUrl}&preview=1" data-preview-download="${downloadUrl}" data-preview-name="${escapeHTML(name)}" aria-label="View ${escapeHTML(name)} full screen"><img src="${downloadUrl}&preview=1" alt="Preview of ${escapeHTML(name)}" loading="lazy" /></button><a class="comment-attachment-download" href="${downloadUrl}" download aria-label="Download ${escapeHTML(name)}" title="Download ${escapeHTML(name)}">${icon} Download</a></span>`;
				}
				return `<a class="comment-attachment-link" href="${downloadUrl}" download aria-label="Download ${escapeHTML(name)}" title="${escapeHTML(name)}">${icon}</a>`;
			}).join("");
			const textMarkup = c.text
				? `<div class="comment-bubble-text">${escapeHTML(String(c.text))}</div>`
				: "";
			const attachmentMarkup = attachmentLinks
				? `<div class="comment-attachment-list">${attachmentLinks}</div>`
				: "";
			return `
				<div class="comment-bubble">
					<div class="comment-bubble-meta">
						<strong>${escapeHTML(String(c.author || "User"))}</strong>
						<span>${escapeHTML(String(c.time || ""))}</span>
					</div>
					${textMarkup}
					${attachmentMarkup}
				</div>
			`;
		}).join("");

		applyDashboardStyleScope(feed);
		feed.scrollTop = feed.scrollHeight;
		return true;
	} catch (error) {
		feed.textContent = error instanceof Error ? error.message : "Unable to load comments.";
		return false;
	}
}

async function markCommentsRead(noteId: string): Promise<boolean> {
	try {
		const response = await fetch("/comments-api", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ action: "read", noteId })
		});
		const result = await response.json();
		if (!response.ok || !result.success) {
			throw new Error(result.message || "Unable to mark comments as read.");
		}
		return true;
	} catch (error) {
		showNotificationToast(error instanceof Error ? error.message : "Unable to update read status.", true);
		return false;
	}
}

const unreadCommentCounts = new Map<string, number>();
let unreadCommentsInitialized = false;
let unreadCommentsRefreshInProgress = false;

function updateUnreadBadge(noteId: string, count: number) {
	const button = document.querySelector<HTMLButtonElement>(`.btn-comment-toggle[data-id="${noteId}"]`);
	const badge = button?.querySelector<HTMLElement>("[data-unread-count]");
	if (!button || !badge) return;

	badge.hidden = count < 1;
	badge.textContent = count > 99 ? "99+" : String(count);
	button.setAttribute("aria-label", count > 0
		? `Open comments, ${count} unread`
		: "Open comments");
}

async function refreshUnreadComments() {
	if (document.visibilityState !== "visible" || unreadCommentsRefreshInProgress) return;
	unreadCommentsRefreshInProgress = true;

	try {
		const response = await fetch("/comments-api?mode=unread");
		const result = await response.json();
		if (!response.ok || !result.success || !Array.isArray(result.unreadNotes)) {
			throw new Error(result.message || "Unable to check unread comments.");
		}

		const unreadNotes = result.unreadNotes as Array<{
			note_id: number | string;
			title: string;
			unread_count: number | string;
		}>;
		const latestCounts = new Map<string, number>();
		const newlyUnreadTitles: string[] = [];

		for (const unreadNote of unreadNotes) {
			const noteId = String(unreadNote.note_id);
			const count = Number(unreadNote.unread_count);
			if (!Number.isFinite(count) || count < 1) continue;

			const drawer = document.getElementById(`drawer-${noteId}`);
			if (drawer?.classList.contains("drawer-open")) {
				if (await fetchAndRenderComments(noteId) && await markCommentsRead(noteId)) {
					updateUnreadBadge(noteId, 0);
					continue;
				}
			}

			latestCounts.set(noteId, count);
			updateUnreadBadge(noteId, count);
			if (unreadCommentsInitialized && count > (unreadCommentCounts.get(noteId) || 0)) {
				newlyUnreadTitles.push(unreadNote.title);
			}
		}

		for (const noteId of unreadCommentCounts.keys()) {
			if (!latestCounts.has(noteId)) updateUnreadBadge(noteId, 0);
		}

		const totalUnread = [...latestCounts.values()].reduce((total, count) => total + count, 0);
		if (!unreadCommentsInitialized && totalUnread > 0) {
			showNotificationToast(`You have unread comments in ${latestCounts.size} note${latestCounts.size === 1 ? "" : "s"}. Open Chat to review.`);
		} else if (newlyUnreadTitles.length > 0) {
			const titleSummary = newlyUnreadTitles.slice(0, 2).join(", ");
			const remaining = newlyUnreadTitles.length > 2 ? ` and ${newlyUnreadTitles.length - 2} more` : "";
			showNotificationToast(`New comment on ${titleSummary}${remaining}.`);
		}

		unreadCommentCounts.clear();
		for (const [noteId, count] of latestCounts) unreadCommentCounts.set(noteId, count);
		unreadCommentsInitialized = true;
	} catch (error) {
		console.error("Unable to refresh unread comment notifications.", error);
	} finally {
		unreadCommentsRefreshInProgress = false;
	}
}


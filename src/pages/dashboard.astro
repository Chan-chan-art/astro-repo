	const selectedPreviewUrls = new WeakMap<HTMLElement, string[]>();

	function setSelectedImagePreviews(container: HTMLElement, files: File[]) {
		for (const url of selectedPreviewUrls.get(container) || []) URL.revokeObjectURL(url);
		container.replaceChildren();

		const previewUrls: string[] = [];
		const imageFiles = files.filter((file) =>
			file.type.startsWith("image/") || /\.(jpe?g|png|gif|webp|heic|heif)$/i.test(file.name)
		);
		for (const file of imageFiles) {
			const src = URL.createObjectURL(file);
			previewUrls.push(src);
			const button = document.createElement("button");
			button.type = "button";
			button.className = "attachment-preview-open";
			button.dataset.previewSrc = src;
			button.dataset.previewDownload = src;
			button.dataset.previewName = file.name;
			button.setAttribute("aria-label", `View ${file.name} full screen`);
			const image = document.createElement("img");
			image.src = src;
			image.alt = `Preview of ${file.name}`;
			button.append(image);
			container.append(button);
		}
		selectedPreviewUrls.set(container, previewUrls);
	}

	function updateNoteAttachmentStatus() {
		if (!noteAttachmentStatus) return;
		const selectedFiles = [noteFileInput, notePhotoInput, noteCameraInput]
			.flatMap(input => Array.from(input?.files || []));
		const displayedNames = [...new Set(selectedFiles.map(file => file.name))];
		const hasLocation = Boolean(noteLatitudeInput?.value && noteLongitudeInput?.value);
		noteAttachmentStatus.replaceChildren();
		if (displayedNames.length > 0) {
			noteAttachmentStatus.textContent = `Selected: ${displayedNames.join(", ")}`;
		}
		if (hasLocation) {
			if (displayedNames.length > 0) noteAttachmentStatus.append(document.createTextNode(" · "));
			const latitude = noteLatitudeInput?.value || "";
			const longitude = noteLongitudeInput?.value || "";
			const locationLink = document.createElement("a");
			locationLink.href = `https://www.google.com/maps?q=${encodeURIComponent(`${latitude},${longitude}`)}`;
			locationLink.target = "_blank";
			locationLink.rel = "noopener noreferrer";
			locationLink.textContent = `📍 Exact location: ${latitude}, ${longitude}`;
			noteAttachmentStatus.append(locationLink);
		}
		if (selectedFiles.length === 0 && !hasLocation) {
			noteAttachmentStatus.textContent = "No attachments selected.";
		}
	}

	document.getElementById("attachFileButton")?.addEventListener("click", () => noteFileInput?.click());
	document.getElementById("attachPhotoButton")?.addEventListener("click", () => notePhotoInput?.click());
	document.getElementById("attachCameraButton")?.addEventListener("click", () => noteCameraInput?.click());
	[noteFileInput, notePhotoInput, noteCameraInput].forEach(input => {
		input?.addEventListener("change", updateNoteAttachmentStatus);
	});

	document.getElementById("attachLocationButton")?.addEventListener("click", () => {
		if (!navigator.geolocation) {
			showNotificationToast("Location is not supported by this browser.", true);
			return;
		}
		if (noteAttachmentStatus) noteAttachmentStatus.textContent = "Getting your location…";
		navigator.geolocation.getCurrentPosition(
			(position) => {
				if (noteLatitudeInput) noteLatitudeInput.value = String(position.coords.latitude);
				if (noteLongitudeInput) noteLongitudeInput.value = String(position.coords.longitude);
				updateNoteAttachmentStatus();
			},
			(error) => {
				updateNoteAttachmentStatus();
				showNotificationToast(`Could not get location: ${error.message}`, true);
			},
			{ enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
		);
	});

	addNoteForm?.addEventListener("reset", () => {
		setTimeout(updateNoteAttachmentStatus, 0);
	});

	// ==========================================
	// 3. UNIFIED COMBINED SEARCH/FILTER SYSTEM
	// ==========================================
	function updateWorkspaceVisibility() {
		const searchQuery = workspaceSearch?.value.toLowerCase().trim() || "";
		const noteCards = document.querySelectorAll(".notes-grid .note-item");

		noteCards.forEach((card) => {
			const titleText = card.querySelector("h4")?.textContent?.toLowerCase() || "";
			const contentText = card.querySelector("p")?.textContent?.toLowerCase() || "";
			const cardCategory = card.getAttribute("data-category") || "General";

			const matchesSearch = titleText.includes(searchQuery) || contentText.includes(searchQuery);
			const matchesTab = activeCategoryFilter === "all"
				|| (activeCategoryFilter === "favorites"
					? (card as HTMLElement).dataset.favorite === "true"
					: activeCategoryFilter === "pinned"
						? (card as HTMLElement).dataset.pinned === "true"
						: cardCategory === activeCategoryFilter);

			if (matchesSearch && matchesTab) {
				card.classList.remove("filtered-out");
			} else {
				card.classList.add("filtered-out");
			}
		});

		// Empty state checker
		const visibleCards = document.querySelectorAll(".notes-grid .note-item:not(.filtered-out)");
		let noResultsMsg = document.getElementById("noSearchResultsMessage");
		if (visibleCards.length === 0 && noteCards.length > 0) {
			if (!noResultsMsg) {
				document.querySelector(".notes-grid")?.insertAdjacentHTML("beforeend", `
					<div id="noSearchResultsMessage" style="grid-column: 1 / -1; text-align:center; color:rgba(255,255,255,0.4); padding: 40px 20px;">
						🔍 No notes match your active filter metrics.
					</div>
				`);
			}
		} else {
			noResultsMsg?.remove();
		}
	}

	// Connect Event listeners to Tab Switch Buttons
	document.querySelectorAll(".tab-btn").forEach(btn => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
			btn.classList.add("active");
			
			activeCategoryFilter = btn.getAttribute("data-filter") || "all";
			updateWorkspaceVisibility();
		});
	});

	if (activeCategoryFilter !== "all") {
		document.querySelectorAll(".tab-btn").forEach((btn) => btn.classList.remove("active"));
		document.querySelector(`.tab-btn[data-filter="${activeCategoryFilter}"]`)?.classList.add("active");
	}
	updateWorkspaceVisibility();

	// Re-route Search Field inputs to call the unified visibility controller
	workspaceSearch?.addEventListener("input", () => {
		if (workspaceSearch.value.length > 0) clearSearchBtn?.classList.add("is-visible");

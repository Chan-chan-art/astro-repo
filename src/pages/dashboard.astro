}
/* 🌟 Skeleton Loading Card Styles */
.note-skeleton {
	background: rgba(255, 255, 255, 0.05);
	border: 1px solid rgba(255, 255, 255, 0.06);
	padding: 20px;
	border-radius: 18px;
	min-height: 140px;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	position: relative;
	overflow: hidden;
}

/* Shimmer overlay block mapping */
.note-skeleton::after {
	content: "";
	position: absolute;
	top: 0; right: 0; bottom: 0; left: 0;
	transform: translateX(-100%);
	background: linear-gradient(
		90deg,
		rgba(255, 255, 255, 0) 0%,
		rgba(255, 255, 255, 0.08) 20%,
		rgba(255, 255, 255, 0.15) 60%,
		rgba(255, 255, 255, 0) 100-30%
	);
	animation: shimmer 1.6s infinite;
}

@keyframes shimmer {
	100% {
		transform: translateX(100%);
	}
}

/* Skeleton interior bone shapes */
.skeleton-bone {
	background: rgba(255, 255, 255, 0.12);
	border-radius: 6px;
}

.bone-title {
	width: 65%;
	height: 16px;
	margin-bottom: 12px;
}

.bone-text-1 {
	width: 90%;
	height: 12px;
	margin-bottom: 8px;
}

.bone-text-2 {
	width: 75%;

}
/* 🌟 Skeleton Loading Card Styles */
.note-skeleton {
	background: rgba(255, 255, 255, 0.05);
	border: 1px solid rgba(255, 255, 255, 0.06);
	padding: 20px;
	border-radius: 18px;
	min-height: 140px;

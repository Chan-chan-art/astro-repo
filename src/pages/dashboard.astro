<script>
	// ==========================================
	// 1. GLOBAL SCOPE UTILITY FUNCTIONS FIRST
	// ==========================================
	
	// Secure escape helper to prevent cross-site script injections (XSS)
	function escapeHTML(str: string): string {
		return str.replace(/[&<>'"]/g, 
			tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
		);
	}

	// Re-binding listener to attach smooth delete animations to newly added cards
	function attachDeleteListener(btn: Element | null) {
		if (!btn) return;
		btn.addEventListener("click", async () => {
			const id = btn.getAttribute("data-id");
			const cardItem = btn.closest(".note-item");
			if (!id || !cardItem) return;

			if (confirm("Permanently drop this note out of your workspace records?")) {
				try {
					cardItem.classList.add("removing");
					const res = await fetch(`/notes-api?id=${id}`, { method: 'DELETE' });
					const data = await res.json();
					if (data.success) {
						if (data.warning) showNotificationToast(data.warning, true);
						setTimeout(() => {
							cardItem.remove();
							updateDashboardStatistics();
							const remainingCards = document.querySelectorAll(".note-item");
							if (remainingCards.length === 0) {
								window.location.reload();
							}
						}, 300);
					} else {
						cardItem.classList.remove("removing");
						alert(data.message || "Failed to remove workspace entry.");
					}
				} catch { 
					cardItem.classList.remove("removing");
					alert("Error deleting workspace entry."); 
				}
			}
		});
	}

	function getNoteCard(element: Element | null): HTMLElement | null {
		return element?.closest<HTMLElement>(".note-item") || null;
	}

	function openNoteView(card: HTMLElement) {
		const dialog = document.getElementById("noteViewDialog") as HTMLDialogElement | null;
		const title = card.querySelector<HTMLElement>("[data-note-title]")?.textContent || "";
		const content = card.querySelector<HTMLElement>("[data-note-content]")?.textContent || "";
		const category = card.dataset.category || "General";
		const attachmentsContainer = document.getElementById("noteViewAttachments");
		const attachmentList = card.querySelector<HTMLElement>(".note-attachment-list");

		document.getElementById("noteViewTitle")!.textContent = title;
		document.getElementById("noteViewCategory")!.textContent = category;
		document.getElementById("noteViewContent")!.textContent = content;
		document.getElementById("noteViewDate")!.textContent =
			card.querySelector<HTMLElement>(".note-date")?.textContent?.trim() || "Date unavailable";
		if (attachmentsContainer) {
			attachmentsContainer.replaceChildren();
			if (attachmentList) attachmentsContainer.append(attachmentList.cloneNode(true));
			else attachmentsContainer.textContent = "No attachments.";
		}
		dialog?.showModal();
	}

	let editingNoteCard: HTMLElement | null = null;

	function openNoteEdit(card: HTMLElement) {
		const dialog = document.getElementById("noteEditDialog") as HTMLDialogElement | null;
		const form = document.getElementById("noteEditForm") as HTMLFormElement | null;
		if (!dialog || !form) return;

		const role = card.dataset.userRole;
		if (role !== "owner" && role !== "edit") return;
		const noteIdField = form.elements.namedItem("id");
		if (!(noteIdField instanceof HTMLInputElement)) return;
		editingNoteCard = card;
		noteIdField.value = card.dataset.id || "";
		(form.elements.namedItem("title") as HTMLInputElement).value =
			card.querySelector<HTMLElement>("[data-note-title]")?.textContent || "";
		(form.elements.namedItem("content") as HTMLTextAreaElement).value =
			card.querySelector<HTMLElement>("[data-note-content]")?.textContent || "";
		(form.elements.namedItem("category") as HTMLSelectElement).value = card.dataset.category || "General";
		const error = document.getElementById("noteEditError");
		if (error) {
			error.hidden = true;
			error.textContent = "";
		}
		dialog.showModal();
	}

	function updateDashboardStatistics() {
		const counts = { total: 0, general: 0, work: 0, personal: 0, ideas: 0 };
		document.querySelectorAll<HTMLElement>(".notes-grid .note-item:not(.note-skeleton)").forEach((card) => {
			counts.total += 1;
			const category = card.dataset.category || "General";
			if (category === "General") counts.general += 1;
			if (category === "Work") counts.work += 1;
			if (category === "Personal") counts.personal += 1;
			if (category === "Ideas") counts.ideas += 1;
		});

		for (const [stat, count] of Object.entries(counts)) {
			const element = document.querySelector<HTMLElement>(`[data-note-stat="${stat}"]`);
			if (element) element.textContent = String(count);
		}
	}


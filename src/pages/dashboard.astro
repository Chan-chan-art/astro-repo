			What are you thinking? 
			<span class="char-counter" id="contentCounter">(0 / 120)</span>
		</label>
		<input 
			type="text" 
			id="noteContent" 
			name="content" 
			placeholder="Remember to review the database..." 
			maxlength="120"
			required 
		/>
	</div>
	
	<button type="submit" class="btn-add-note">Add Note</button>
</form>


				<!-- Dynamic Rendered Notes Feed List -->
<div class="notes-grid">
	{userNotes.length === 0 ? (
		<div style="grid-column: 1 / -1; text-align:center; color:rgba(255,255,255,0.5); padding: 60px 20px;">
			<span style="font-size: 40px; display:block; margin-bottom:10px;">📋</span>
			<p style="margin:0;">Your workspace is empty. Type a note above to store it safely!</p>
		</div>
	) : (
		userNotes.map((note) => (
			<div class="note-item">
				<button class="btn-delete-note" data-id={note.id} title="Delete this note">✕</button>
				<div>
					<h4>{note.title}</h4>
					<p>{note.content}</p>
				</div>
				<span class="note-date">🗓️ {note.date}</span>
			</div>
		))
	)}
</div>
	</div>
		</div>

		<!-- 🔔 Floating Glassmorphic Notification Toast Banner -->
<div id="notificationToast" class="notification-toast" aria-live="polite">
	<span id="toastIcon">✨</span>
	<span id="toastMessage">Profile settings saved successfully!</span>
</div>


		<!-- CLIENT SIDE INTERACTIVE CONTROLLERS -->
		<script>
	// ==========================================
	// 1. SCOPE INDEPENDENT UTILITY FUNCTIONS
	// ==========================================
	
	// Secure escape helper to prevent cross-site script injections (XSS)
	function escapeHTML(str: string): string {
		return str.replace(/[&<>'"]/g, 
			tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
		);
	}

	// Re-binding listener to attach smooth delete animations to newly added cards
	function attachDeleteListener(btn: Element | null) {
		if (!btn) return;
		btn.addEventListener("click", async () => {
			const id = btn.getAttribute("data-id");
			const cardItem = btn.closest(".note-item");
			if (!id || !cardItem) return;

			if (confirm("Permanently drop this note out of your workspace records?")) {
				try {
					cardItem.classList.add("removing");
					const res = await fetch(`/notes-api?id=${id}`, { method: 'DELETE' });
					const data = await res.json();
					if (data.success) {
						setTimeout(() => {
							cardItem.remove();
							const remainingCards = document.querySelectorAll(".note-item");
							if (remainingCards.length === 0) {
								window.location.reload();
							}
						}, 300);
					} else {
						cardItem.classList.remove("removing");
						alert(data.message || "Failed to remove workspace entry.");
					}
				} catch { 
					cardItem.classList.remove("removing");
					alert("Error deleting workspace entry."); 
				}
			}
		});
	}

	// ==========================================
	// 2. FORM AND INTERFACE TARGET INITIALIZERS
	// ==========================================
	const profileForm = document.getElementById("profileForm") as HTMLFormElement | null;
	const addNoteForm = document.getElementById("addNoteForm") as HTMLFormElement | null;
	const avatarFileInput = document.getElementById("avatarFileInput") as HTMLInputElement | null;
	const avatarPreviewImage = document.querySelector(".avatar-preview") as HTMLImageElement | null;
	const inputTitle = document.getElementById("noteTitle") as HTMLInputElement | null;
	const inputContent = document.getElementById("noteContent") as HTMLInputElement | null;
	const titleCounter = document.getElementById("titleCounter");
	const contentCounter = document.getElementById("contentCounter");
	const profileBioInput = document.getElementById("profileBio") as HTMLTextAreaElement | null;
	const bioCounter = document.getElementById("bioCounter");


	// Attach initial deletion events to all static server-rendered notes on boot load
	document.querySelectorAll(".btn-delete-note").forEach(btn => {
		attachDeleteListener(btn);
	});

	// ==========================================
	// 3. ACTION AND TRANSACTION EVENT LISTENERS
	// ==========================================

	// Handle Note Submission
	addNoteForm?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const notesGrid = document.querySelector(".notes-grid");
		if (!notesGrid) return;

		const emptyPrompt = notesGrid.querySelector("div");
		if (emptyPrompt && emptyPrompt.textContent?.includes("Your workspace is empty")) {
			emptyPrompt.remove();
		}

		const titleValue = inputTitle ? inputTitle.value.trim() : "";
		const contentValue = inputContent ? inputContent.value.trim() : "";

		// Append Shimmer Skeleton Placeholder Card
		const skeletonHTML = `
			<div class="note-item note-skeleton" id="activeCreationSkeleton">
				<div>
					<div class="skeleton-bone bone-title"></div>
					<div class="skeleton-bone bone-text-1"></div>
					<div class="skeleton-bone bone-text-2"></div>
				</div>
				<div class="skeleton-bone bone-date"></div>
			</div>
		`;
		notesGrid.insertAdjacentHTML("afterbegin", skeletonHTML);

		const formData = new FormData();
		formData.append("title", titleValue);
		formData.append("content", contentValue);

		addNoteForm.reset();
		if (titleCounter) titleCounter.textContent = "(0 / 30)";
		if (contentCounter) contentCounter.textContent = "(0 / 120)";

		try {
			const res = await fetch('/notes-api', { method: 'POST', body: formData });
			const data = await res.json();
			const skeletonCard = document.getElementById("activeCreationSkeleton");

			if (data.success && skeletonCard) {
				skeletonCard.classList.remove("note-skeleton");
				skeletonCard.removeAttribute("id");
				skeletonCard.innerHTML = `
					<button class="btn-delete-note" data-id="${data.id}" title="Delete this note">✕</button>
					<div>
						<h4>${escapeHTML(titleValue)}</h4>
						<p>${escapeHTML(contentValue)}</p>
					</div>
					<span class="note-date">🗓️ Saved Just now</span>
				`;
				attachDeleteListener(skeletonCard.querySelector(".btn-delete-note"));
			} else {
				document.getElementById("activeCreationSkeleton")?.remove();
				alert(data.message || "Failed to save note.");
			}
		} catch { 
			document.getElementById("activeCreationSkeleton")?.remove();
			alert("Error reaching node workspace endpoint."); 
		}
	});

	// Select Search and Clear Button Elements
const workspaceSearch = document.getElementById("workspaceSearch") as HTMLInputElement | null;
const clearSearchBtn = document.getElementById("clearSearchBtn") as HTMLButtonElement | null;

// Helper logic to execute text filtering layout updates
function filterWorkspaceNotes(query: string) {
	const noteCards = document.querySelectorAll(".notes-grid .note-item");

	noteCards.forEach((card) => {
		const titleText = card.querySelector("h4")?.textContent?.toLowerCase() || "";
		const contentText = card.querySelector("p")?.textContent?.toLowerCase() || "";
		const matchFound = titleText.includes(query) || contentText.includes(query);

		if (matchFound) card.classList.remove("filtered-out");
		else card.classList.add("filtered-out");
	});

	// Handle empty state tracking strings
	const visibleCards = document.querySelectorAll(".notes-grid .note-item:not(.filtered-out)");
	let noResultsMsg = document.getElementById("noSearchResultsMessage");

	if (visibleCards.length === 0 && noteCards.length > 0) {
		if (!noResultsMsg) {
			document.querySelector(".notes-grid")?.insertAdjacentHTML("beforeend", `
				<div id="noSearchResultsMessage" style="grid-column: 1 / -1; text-align:center; color:rgba(255,255,255,0.4); padding: 40px 20px;">
					🔍 No notes match your search query string.
				</div>
			`);
		}
	} else {
		noResultsMsg?.remove();
	}
}

// 1. Upgrade input listener to control clear button visibility toggle states
workspaceSearch?.addEventListener("input", () => {
	const query = workspaceSearch.value.toLowerCase().trim();
	
	// Control dynamic clear button presence flag
	if (workspaceSearch.value.length > 0) {
		clearSearchBtn?.classList.add("is-visible");
	} else {
		clearSearchBtn?.classList.remove("is-visible");
	}
	
	filterWorkspaceNotes(query);
});

// 2. Clear Button click action listener
clearSearchBtn?.addEventListener("click", () => {
	if (!workspaceSearch) return;

	// Wipes text, hides button, and places the cursor right back in the field
	workspaceSearch.value = "";
	clearSearchBtn.classList.remove("is-visible");
	workspaceSearch.focus();

	// Reset grid layout so all workspace note cards fade back into view immediately
	filterWorkspaceNotes("");
});


	// Input Character Countdown Metrics Helper Initializers
	function setupLiveCounter(input: HTMLInputElement | null, counterEl: HTMLElement | null, maxLength: number) {
		if (!input || !counterEl) return;
		input.addEventListener("input", () => {
			const currentLength = input.value.length;
			counterEl.textContent = `(${currentLength} / ${maxLength})`;
			if (currentLength >= maxLength) counterEl.classList.add("limit-reached");
			else counterEl.classList.remove("limit-reached");
		});
	}
	setupLiveCounter(inputTitle, titleCounter, 30);
	setupLiveCounter(inputContent, contentCounter, 120);

	// Boot load calculation: If a bio already exists from MySQL, update the counter on page load
if (profileBioInput && bioCounter) {
	const currentBioLength = profileBioInput.value.length;
	bioCounter.textContent = `(${currentBioLength} / 250)`;
	if (currentBioLength >= 250) bioCounter.classList.add("limit-reached");
}

// Map real-time typing listeners onto the profile bio textarea
profileBioInput?.addEventListener("input", () => {
	if (!bioCounter) return;
	const currentLength = profileBioInput.value.length;
	
	bioCounter.textContent = `(${currentLength} / 250)`;
	
	if (currentLength >= 250) {
		bioCounter.classList.add("limit-reached");
	} else {
		bioCounter.classList.remove("limit-reached");
	}
});


	// Avatar Live File Preview Reader System
	avatarFileInput?.addEventListener("change", () => {
		const fileList = avatarFileInput.files;
		if (!fileList || fileList.length === 0) return;
		const targetedFile = fileList[0];

		if (!targetedFile.type.startsWith("image/")) {
			alert("Please choose a valid image file configuration (.png, .jpg, .webp).");
			avatarFileInput.value = "";
			return;
		}

		const fileStreamReader = new FileReader();
		fileStreamReader.onload = (event) => {
			const parsedResultString = event.target?.result;
			if (avatarPreviewImage && typeof parsedResultString === "string") {
				avatarPreviewImage.src = parsedResultString;
			}
		};
		fileStreamReader.readAsDataURL(targetedFile);
	});

	avatarPreviewImage?.addEventListener("click", () => {
		avatarFileInput?.click();
	});

	// Profile Save Notification Banner Toast Interceptor
	profileForm?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!profileForm) return;

		const submitBtn = profileForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
		if (submitBtn) submitBtn.disabled = true;

		const formData = new FormData(profileForm);
		try {
			const res = await fetch('/profile-api', { method: 'POST', body: formData });
			const data = await res.json();

			if (data.success) {
				const enteredName = formData.get("displayName")?.toString().trim();
				const h1Header = document.querySelector(".profile-card h1");
				if (h1Header && enteredName) h1Header.textContent = enteredName;
				showNotificationToast("✨ Profile details saved flawlessly!");
			} else {
				showNotificationToast("❌ " + (data.message || "Failed to update profile settings."), true);
			}
		} catch { 
			showNotificationToast("❌ Error reaching profile workspace endpoint.", true);
		} finally {
			if (submitBtn) submitBtn.disabled = false;
		}
	});

	function showNotificationToast(msg: string, isError: boolean = false) {
		const toast = document.getElementById("notificationToast");
		const toastText = document.getElementById("toastMessage");
		if (!toast || !toastText) return;

		toastText.textContent = msg;
		if (isError) toast.classList.add("toast-error");
		else toast.classList.remove("toast-error");

		toast.classList.add("toast-active");
		setTimeout(() => toast.classList.remove("toast-active"), 3500);
	}
</script>
</body>

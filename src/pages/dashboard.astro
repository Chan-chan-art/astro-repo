}

.btn-clear-search:hover {
	background: rgba(255, 255, 255, 0.25);
	color: #fff;
	transform: translateY(-50%) scale(1.08);
}
.char-counter {
	font-size: 10px;
	color: rgba(255, 255, 255, 0.4);
	float: right;
	font-weight: normal;
	letter-spacing: 0px;
	transition: color 0.2s ease;
	line-height: 14px; /* Aligns smoothly with field headers */
}


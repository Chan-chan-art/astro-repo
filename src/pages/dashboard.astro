	const chatText = inputField.value.trim();
	const hasFiles = Array.from(targetForm.querySelectorAll<HTMLInputElement>(".chat-attachment-input"))
		.some(input => Boolean(input.files?.length));
	const hasLocation = Boolean(
		targetForm.querySelector<HTMLInputElement>('input[name="latitude"]')?.value &&
		targetForm.querySelector<HTMLInputElement>('input[name="longitude"]')?.value
	);
	if (chatText === "" && !hasFiles && !hasLocation) return;

	const formData = new FormData(targetForm);
	formData.set("noteId", noteId);
	formData.set("text", chatText);

	submitButton.disabled = true;
	try {
		const res = await fetch('/comments-api', { method: 'POST', body: formData });
		const data = await res.json();
		if (!res.ok || !data.success) {
			throw new Error(data.message || "Unable to post your comment.");

// src/pages/dashboard.astro
import { pool } from '../lib/db';
import WorkspaceNavigation from '../components/WorkspaceNavigation.astro';
export const prerender = false;

const sessionCookie = Astro.cookies.get("user_session");
let sessionData = null;

if (sessionCookie && sessionCookie.value.trim() !== "") {
  try {
    sessionData = sessionCookie.json();
  } catch (e) {
    console.error("Invalid session cookie JSON format:", e);
    Astro.cookies.delete("user_session"); 
  }
}

if (!sessionData || !sessionData.username) {
  return Astro.redirect('/'); 
}

const username = sessionData.username;

let displayName = "";
let bio = "";
let address = "";
let avatarUrl = "/default-avatar.png";
let userId: number | string | null = null;
let userNotes: any[] = [];

try {
  const [userRows]: any = await pool.execute(
    'SELECT id, display_name, bio, address, avatar_url FROM users WHERE BINARY username = ?',
    [username]
  );
  
  if (userRows.length === 1) {
    displayName = userRows[0].display_name || "";
    bio = userRows[0].bio || "";
    address = userRows[0].address || "";
    avatarUrl = userRows[0].avatar_url || "/default-avatar.png";
    
    userId = userRows[0].id;

    const [noteRows]: any = await pool.execute(
      `SELECT 
         n.id, n.title, n.content, n.category, n.user_id as owner_id,
         DATE_FORMAT(n.created_at, "%b %d, %Y") as date,
         u.display_name as owner_name,
         COALESCE(np.is_pinned, 0) as is_pinned,
         COALESCE(np.is_favorite, 0) as is_favorite,
         IF(n.user_id = ?, 'owner', ns.permission_level) as user_role,
         (
           SELECT GROUP_CONCAT(shared_users.username SEPARATOR ', ')
           FROM note_shares note_mapping
           JOIN users shared_users ON note_mapping.shared_with_user_id = shared_users.id
           WHERE note_mapping.note_id = n.id
         ) as shared_users_list
       FROM notes n
       LEFT JOIN users u ON n.user_id = u.id
       LEFT JOIN note_shares ns ON n.id = ns.note_id AND ns.shared_with_user_id = ?
       LEFT JOIN note_preferences np ON np.note_id = n.id AND np.user_id = ?
       WHERE n.user_id = ? OR ns.shared_with_user_id = ?
       ORDER BY COALESCE(np.is_pinned, 0) DESC, n.id DESC`,
      [userId, userId, userId, userId, userId]
    );

    if (noteRows.length > 0) {
      const noteIds = noteRows.map((note: any) => note.id);
      const placeholders = noteIds.map(() => "?").join(", ");
      const [attachmentRows]: any = await pool.execute(
        `SELECT id, note_id, attachment_type, original_name, mime_type,
                file_size, latitude, longitude
         FROM note_attachments
         WHERE note_id IN (${placeholders})
         ORDER BY id ASC`,
        noteIds
      );
      const attachmentsByNote = new Map<string, any[]>();
      for (const attachment of attachmentRows) {
        const key = String(attachment.note_id);
        const attachments = attachmentsByNote.get(key) || [];
        attachments.push(attachment);
        attachmentsByNote.set(key, attachments);
      }
      userNotes = noteRows.map((note: any) => ({
        ...note,
        attachments: attachmentsByNote.get(String(note.id)) || []
      }));
    } else {
      userNotes = noteRows;
    }

  }
} catch (error) {
  console.error("Dashboard Fetch Error:", error);
}

const greetingName = displayName || username;
const noteStatistics = userNotes.reduce(
  (counts, note) => {
    counts.total += 1;
    const category = note.category || "General";
    if (category === "General") counts.general += 1;
    if (category === "Work") counts.work += 1;
    if (category === "Personal") counts.personal += 1;
    if (category === "Ideas") counts.ideas += 1;
    return counts;
  },
  { total: 0, general: 0, work: 0, personal: 0, ideas: 0 }
);

let upcomingReminders: Array<{ id: number; title: string; description: string; date: string; time: string }> = [];
if (userId) {
  try {
    const [reminderRows]: any = await pool.execute(
      `SELECT id, title, description,
              DATE_FORMAT(scheduled_at, '%Y-%m-%d') AS date,
              TIME_FORMAT(scheduled_at, '%H:%i') AS time
       FROM reminders
       WHERE user_id = ? AND is_completed = 0 AND scheduled_at >= NOW()
       ORDER BY scheduled_at ASC
       LIMIT 5`,
      [userId]
    );
    upcomingReminders = reminderRows;
  } catch (error) {
    console.error("Dashboard upcoming reminders fetch error:", error);
  }
}

const miniCalendarMonth = new Date();
const miniCalendarFirstDay = new Date(
  miniCalendarMonth.getFullYear(),
  miniCalendarMonth.getMonth(),
  1
).getDay();
const miniCalendarDates = Array.from({ length: 42 }, (_, index) => {
  const date = new Date(
    miniCalendarMonth.getFullYear(),
    miniCalendarMonth.getMonth(),
    index - miniCalendarFirstDay + 1
  );
  const dateKey = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
  return {
    date,
    dateKey,
    inMonth: date.getMonth() === miniCalendarMonth.getMonth(),
    isToday: dateKey === `${miniCalendarMonth.getFullYear()}-${String(miniCalendarMonth.getMonth() + 1).padStart(2, "0")}-${String(miniCalendarMonth.getDate()).padStart(2, "0")}`,
    hasReminder: upcomingReminders.some((reminder) => reminder.date === dateKey)
  };
});

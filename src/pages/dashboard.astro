	function updateNoteReminderDuePills() {
		const now = new Date();
		const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
		document.querySelectorAll<HTMLTimeElement>(".note-reminder-due-pill").forEach((pill) => {
			const date = pill.dataset.dueDate;
			const time = pill.dataset.dueTime;
			if (!date || !time) return;

			const dueAt = new Date(`${date}T${time}:00`);
			if (Number.isNaN(dueAt.getTime())) return;
			const dueStatus = dueAt.getTime() < now.getTime() ? "overdue" : date === today ? "today" : "upcoming";
			const dueLabel = dueAt.toLocaleString(undefined, {
				month: "short",
				day: "numeric",
				hour: "numeric",
				minute: "2-digit"
			});
			const statusLabel = dueStatus === "today" ? "Today" : dueStatus === "overdue" ? "Overdue" : "Upcoming";
			pill.classList.remove("overdue", "today", "upcoming");
			pill.classList.add(dueStatus);
			pill.textContent = `${statusLabel} · ${dueLabel}`;
			pill.setAttribute("aria-label", `${statusLabel}: ${dueLabel}`);
			pill.title = statusLabel;
			const snoozeButton = pill.closest<HTMLElement>("[data-note-reminder]")?.querySelector<HTMLButtonElement>('[data-reminder-action="snooze"]');
			if (snoozeButton) snoozeButton.hidden = dueStatus === "upcoming";
		});
	}


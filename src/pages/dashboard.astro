<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Dashboard Portal</title>
		<style>

	:root {
		color-scheme: light;
		--dashboard-background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
		--dashboard-text: #fff;
		--dashboard-surface: rgba(255, 255, 255, 0.1);
		--dashboard-surface-soft: rgba(255, 255, 255, 0.07);
		--dashboard-surface-hover: rgba(255, 255, 255, 0.2);
		--dashboard-border: rgba(255, 255, 255, 0.12);
		--dashboard-muted: rgba(255, 255, 255, 0.72);
		--dashboard-input-background: rgba(255, 255, 255, 0.12);
		--dashboard-input-text: #fff;
	}

	body {
	margin: 0;
	display: flex;
	justify-content: center;
	align-items: flex-start; /* Switch from center to flex-start so long mobile pages scroll cleanly from the top down */
	min-height: 100vh;
	background: var(--dashboard-background);
	font-family: Arial, sans-serif;
	color: var(--dashboard-text);
	padding: 15px; /* Compressed padding for mobile edge-clearance */
	box-sizing: border-box;
}

@media (min-width: 768px) {
	body {
		padding: 24px;
	}
}

			/* 🌟 Fully Adaptive Split Grid Layout Wrapper */
.dashboard-container {
	display: grid;
	grid-template-columns: 1fr; /* Default: Stacks vertically into 1 column on mobile layout blocks */
	gap: 24px;
	width: min(1400px, 100%);
	margin: 0 auto;
	box-sizing: border-box;
	align-items: start;
}

.workspace-content {
	min-width: 0;
}

@media (min-width: 901px) {
	.dashboard-container {
		grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
	}
}

/* 🎨 Shared Base Adjustments for Glass Cards */
.glass-card {
	background: var(--dashboard-surface);
	backdrop-filter: blur(12px);
	-webkit-backdrop-filter: blur(12px);
	padding: 25px; /* Slightly tighter internal padding optimized for mobile viewports */
	border-radius: 25px;
	box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
	border: 1px solid var(--dashboard-border);
	box-sizing: border-box;
	width: 100%;
}

@media (min-width: 768px) {
	.glass-card {
		padding: 35px; /* Deepens padding room on wider displays for cleaner breathing space */
	}
}


/* Left sidebar structural constraint normalization */
.profile-card { 
	text-align: center; 
	height: fit-content; 
	position: sticky;
	top: 20px; /* Sticks the sidebar in place on desktop viewports when scrolling through long feeds of note cards */
}

@media (max-width: 900px) {
	.profile-card {
		position: static; /* Disables sticky tracking on mobile devices so it scrolls naturally with the document flow */
	}
}

.btn-edit-profile {
	display: inline-block;
	width: auto;
	margin: -6px 0 12px;
	padding: 7px 12px;
	border: 1px solid rgba(255, 255, 255, 0.25);
	border-radius: 20px;
	background: rgba(255, 255, 255, 0.12);
	color: #fff;
	font-size: 11px;
	text-decoration: none;
}

.btn-edit-profile:hover {
	background: rgba(255, 255, 255, 0.22);
}


			.avatar-preview { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255, 255, 255, 0.4); }
			.avatar-preview { 
	width: 100px; 
	height: 100px; 
	border-radius: 50%; 
	object-fit: cover; 
	border: 3px solid rgba(255, 255, 255, 0.4);
	transition: transform 0.2s ease, border-color 0.2s ease;
}

/* Signal editability when hovering over the profile sidebar picture */
.avatar-preview:hover {
	transform: scale(1.05);
	border-color: #ffffff;
	cursor: pointer;
}


			.form-box { margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.2); }
			label { font-size: 11px; font-weight: bold; display: block; margin-top: 10px; }
			input, textarea {
				width: 100%; padding: 11px; margin: 5px 0 10px 0; border: none; border-radius: 20px;
				background: rgba(255, 255, 255, 0.2); color: #fff; outline: none; box-sizing: border-box; font-family: Arial;
			}
			textarea { border-radius: 15px; resize: none; height: 60px; }
			
			button { padding: 11px; border-radius: 20px; cursor: pointer; font-weight: bold; border: none; width: 100%; }
			.btn-submit { background: #fff; color: #6a11cb; }
			.btn-logout { background: rgba(255, 255, 255, 0.15); color: #fff; margin-top: 15px; border: 1px solid rgba(255, 255, 255, 0.2); }
			
/* 📋 Responsive Add Note Form Wrapper Grid */
.add-note-form {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
	gap: 14px;
	margin-top: 18px;
	background: rgba(255, 255, 255, 0.04);
	border: 1px solid rgba(255, 255, 255, 0.08);
	padding: 18px;
	border-radius: 20px;
	align-items: end;
	box-sizing: border-box;
}

@media (min-width: 900px) {
	.add-note-form {
		column-gap: 16px;
		row-gap: 16px;
	}
}

/* Refined input containers inside form workspace grids */
.form-group {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.form-group label {
	margin-top: 0 !important;
	margin-bottom: 6px;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.5px;
	color: rgba(255, 255, 255, 0.7);
}

.form-group input {
	margin: 0 !important; /* Overwrites old layout margins causing uneven offsets */
	padding: 12px 16px;
	border-radius: 15px;
	background: rgba(255, 255, 255, 0.12);
	border: 1px solid rgba(255, 255, 255, 0.1);
	font-size: 14px;
	transition: border-color 0.2s, background-color 0.2s;
}

.form-group input:focus {
	border-color: #ffffff;
	background: rgba(255, 255, 255, 0.2);
}

/* 🚀 Styled Action Submit Button matching form thickness */
.btn-add-note {
	height: 45px;
	width: 100%;
	margin: 0;
	border-radius: 15px !important;
	background: #ffffff;
	color: #6a11cb;
	font-size: 14px;
	font-weight: bold;
	box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
	transition: transform 0.1s, opacity 0.2s;
}

.btn-add-note:active {
	transform: scale(0.97);
}
/* 🌟 Skeleton Loading Card Styles */
.note-skeleton {
	background: rgba(255, 255, 255, 0.05);
	border: 1px solid rgba(255, 255, 255, 0.06);
	padding: 20px;
	border-radius: 18px;
	min-height: 140px;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	position: relative;
	overflow: hidden;
}

/* Shimmer overlay block mapping */
.note-skeleton::after {
	content: "";
	position: absolute;
	top: 0; right: 0; bottom: 0; left: 0;
	transform: translateX(-100%);
	background: linear-gradient(
		90deg,
		rgba(255, 255, 255, 0) 0%,
		rgba(255, 255, 255, 0.08) 20%,
		rgba(255, 255, 255, 0.15) 60%,
		rgba(255, 255, 255, 0) 100-30%
	);
	animation: shimmer 1.6s infinite;
}

@keyframes shimmer {
	100% {
		transform: translateX(100%);
	}
}

/* Skeleton interior bone shapes */
.skeleton-bone {
	background: rgba(255, 255, 255, 0.12);
	border-radius: 6px;
}

.bone-title {
	width: 65%;
	height: 16px;
	margin-bottom: 12px;
}

.bone-text-1 {
	width: 90%;
	height: 12px;
	margin-bottom: 8px;
}

.bone-text-2 {
	width: 75%;
	height: 12px;
	margin-bottom: 15px;
}

.bone-date {
	width: 40%;
	height: 10px;
	margin-top: auto;
}

/* Utility to smoothly fade out empty state messages */
.fade-out {
	opacity: 0;
	transition: opacity 0.3s ease;
}
/* Live Input Counter Meta Labels */
.char-counter {
	font-size: 10px;
	color: rgba(255, 255, 255, 0.4);
	float: right; /* Automatically floats indicator text cleanly to the far right margin edge */
	font-weight: normal;
	letter-spacing: 0px;
	transition: color 0.2s ease;
}

/* Warning accent state when approaching or hitting absolute database length thresholds */
.char-counter.limit-reached {
	color: #ff7675;
	font-weight: bold;
}
/* 🗑️ Smooth Deletion Animation States */
.note-item.removing {
	opacity: 0;
	transform: scale(0.9) translateY(10px);
	max-height: 0;
	padding-top: 0 !important;
	padding-bottom: 0 !important;
	margin-top: 0 !important;
	margin-bottom: 0 !important;
	border-color: transparent;
	overflow: hidden;
	transition: opacity 0.3s ease, 
	            transform 0.3s ease, 
	            max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
	            padding 0.3s ease, 
	            margin 0.3s ease;
}
/* 🔍 Glassmorphic Search Filter Workspace Input */
.search-wrapper {
	position: relative;
	margin-top: 15px;
	margin-bottom: 20px;
	width: 100%;
}

.dashboard-statistics {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 110px), 1fr));
	gap: 10px;
	margin-top: 16px;
}

.dashboard-stat-card {
	min-width: 0;
	padding: 12px;
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 14px;
	background: rgba(255, 255, 255, 0.07);
	box-sizing: border-box;
}

.dashboard-stat-card strong {
	display: block;
	font-size: 20px;
	line-height: 1.2;
}

.dashboard-stat-card span {
	display: block;
	margin-top: 4px;
	color: rgba(255, 255, 255, 0.72);
	font-size: 11px;
	overflow-wrap: anywhere;
}

.workspace-view-title {
	margin: 16px 0 0;
	font-size: 18px;
}

.trash-toolbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 12px;
	margin-top: 18px;
	padding: 12px 14px;
	border: 1px solid var(--dashboard-border);
	border-radius: 12px;
	background: var(--dashboard-surface-soft);
}

.trash-toolbar p {
	flex: 1 1 220px;
	margin: 0;
	color: var(--dashboard-muted);
	font-size: 12px;
	line-height: 1.5;
}

.trash-toolbar button,
.note-card-actions .btn-delete-forever {
	flex: 0 0 auto;
	width: auto;
	padding: 7px 12px;
	border: 1px solid rgba(255, 170, 170, 0.4);
	border-radius: 10px;
	background: rgba(255, 118, 117, 0.18);
	color: #fff;
	font-size: 12px;
	font-weight: 700;
}

.trash-toolbar button:disabled,
.note-card-actions button:disabled {
	cursor: wait;
	opacity: 0.65;
}

.trash-days-left {
	display: inline-block;
	margin-top: 10px;
	padding: 4px 8px;
	border-radius: 999px;
	background: rgba(255, 215, 0, 0.16);
	color: #fff0a6;
	font-size: 11px;
	font-weight: 700;
}

.search-wrapper input {
	width: 100%;
	padding: 12px 16px 12px 42px !important; /* Extra left padding to make room for the search icon */
	border-radius: 15px;
	background: rgba(255, 255, 255, 0.06);
	border: 1px solid rgba(255, 255, 255, 0.08);
	color: #fff;
	font-size: 14px;
	outline: none;
	box-sizing: border-box;
	transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
}

.search-wrapper input:focus {
	border-color: #ffffff;
	background: rgba(255, 255, 255, 0.15);
	box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
}

.search-icon {
	position: absolute;
	left: 15px;
	top: 50%;
	transform: translateY(-50%);
	font-size: 14px;
	opacity: 0.5;
	pointer-events: none; /* Ensures clicking the icon focuses the text box behind it */
}

/* 🌀 Filtering CSS Utility States */
.note-item {
	position: relative;
	display: flex;
	flex-direction: column;
	gap: 12px;
	min-width: 0;
	min-height: 170px;
	padding: 18px;
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 18px;
	background: rgba(255, 255, 255, 0.07);
	box-sizing: border-box;
	transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.2s ease, scale 0.2s ease !important;
}

.note-controls {
	display: flex;
	align-items: center;
	gap: 8px;
}

.note-selection-control {
	display: inline-grid;
	flex: 0 0 30px;
	place-items: center;
	width: 30px;
	height: 30px;
	margin-right: auto;
	border: 1px solid rgba(255, 255, 255, 0.2);
	border-radius: 9px;
	background: rgba(255, 255, 255, 0.08);
	opacity: 0;
	transition: opacity 0.15s ease;
}

.note-item:hover .note-selection-control,
.note-item:focus-within .note-selection-control,
.note-item.is-selected .note-selection-control {
	opacity: 1;
}

.note-selection-checkbox {
	width: 17px !important;
	height: 17px !important;
	margin: 0 !important;
	padding: 0 !important;
	accent-color: #a78bfa;
	cursor: pointer;
}

.bulk-actions-bar {
	position: fixed;
	z-index: 9998;
	right: 14px;
	bottom: 18px;
	left: 14px;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-wrap: wrap;
	gap: 8px;
	width: fit-content;
	max-width: calc(100vw - 28px);
	margin: 0 auto;
	padding: 11px 14px;
	border: 1px solid var(--dashboard-border);
	border-radius: 16px;
	background: var(--dashboard-surface);
	color: var(--dashboard-text);
	box-shadow: 0 16px 44px rgba(0, 0, 0, 0.35);
	backdrop-filter: blur(16px);
	-webkit-backdrop-filter: blur(16px);
	animation: bulk-actions-enter 0.2s ease-out both;
}

.bulk-actions-bar[hidden] { display: none !important; }

.bulk-selection-count {
	padding: 0 5px;
	font-size: 12px;
	font-weight: 700;
	white-space: nowrap;
}

.bulk-actions-bar button {
	width: auto;
	padding: 7px 10px;
	border: 1px solid var(--dashboard-border);
	border-radius: 10px;
	background: var(--dashboard-surface-soft);
	color: var(--dashboard-text);
	font-size: 11px;
	cursor: pointer;
}

.bulk-actions-bar button:hover { background: var(--dashboard-surface-hover); }
.bulk-actions-bar button:disabled { cursor: not-allowed; opacity: 0.55; }

.bulk-actions-bar [data-bulk-action="trash"] {
	border-color: rgba(255, 118, 117, 0.45);
	background: rgba(255, 118, 117, 0.14);
}

@keyframes bulk-actions-enter {
	from { opacity: 0; transform: translateY(12px); }
	to { opacity: 1; transform: translateY(0); }
}

@media (hover: none) {
	.note-selection-control { opacity: 1; }
}

@media (max-width: 600px) {
	.bulk-actions-bar {
		right: 8px;
		bottom: 12px;
		left: 8px;
		max-width: calc(100vw - 16px);
	}
}

@media (prefers-reduced-motion: reduce) {
	.note-selection-control,
	.bulk-actions-bar { animation: none; transition: none; }
}

.notes-grid {

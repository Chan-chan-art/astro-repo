---
// src/pages/dashboard.astro
import { pool } from '../lib/db';
export const prerender = false;

// 1. Verify session cookie status
const sessionCookie = Astro.cookies.get("user_session");
if (!sessionCookie) {
  return Astro.redirect('/'); 
}
const username = sessionCookie.value;

// 2. Fetch the user's profile data, including their avatar
let displayName = "";
let bio = "";
let address = "";
let avatarUrl = "/default-avatar.png";

try {
  const [rows]: any = await pool.execute(
    'SELECT display_name, bio, address, avatar_url FROM users WHERE BINARY username = ?',
    [username]
  );
  if (rows.length === 1) {
    displayName = rows[0].display_name || "";
    bio = rows[0].bio || "";
    address = rows[0].address || "";
    avatarUrl = rows[0].avatar_url || "/default-avatar.png";
  }
} catch (error) {
  console.error("Dashboard Data Fetch Error:", error);
}

const greetingName = displayName || username;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Dashboard</title>
		<style>
			body {
				margin: 0;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
				font-family: Arial, sans-serif;
				color: #fff;
				padding: 40px 0;
				box-sizing: border-box;
			}
			.dashboard-card {
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(10px);
				padding: 40px 50px;
				border-radius: 25px;
				text-align: center;
				box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
				width: 30%;
				box-sizing: border-box;
			}
			h1 { margin-top: 10px; margin-bottom: 5px; font-size: 26px; }
			p { color: rgba(255, 255, 255, 0.8); margin-bottom: 25px; font-size: 14px; }
			
			/* 🌟 Avatar Styling */
			.avatar-container {
				position: relative;
				display: inline-block;
				margin-bottom: 10px;
			}
			.avatar-preview {
				width: 110px;
				height: 110px;
				border-radius: 50%;
				object-fit: cover;
				border: 3px solid rgba(255, 255, 255, 0.4);
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
			}
			
			.form-box {
				margin-top: 20px;
				padding-top: 20px;
				border-top: 1px solid rgba(255, 255, 255, 0.2);
				text-align: left;
			}
			.form-box h3 { text-align: center; margin-top: 0; margin-bottom: 15px; font-size: 18px; }
			
			label { font-size: 12px; font-weight: bold; color: rgba(255, 255, 255, 0.9); margin-left: 5px; }
			input, textarea {
				width: 100%;
				padding: 12px;
				margin: 6px 0 14px 0;
				border: none;
				border-radius: 25px;
				background: rgba(255, 255, 255, 0.2);
				color: #fff;
				outline: none;
				box-sizing: border-box;
				font-family: Arial, sans-serif;
			}
			textarea { border-radius: 15px; resize: none; height: 70px; }
			input[type="file"] {
				background: transparent;
				padding: 5px;
				font-size: 12px;
			}
			
			button { padding: 12px 15px; border-radius: 25px; cursor: pointer; font-weight: bold; border: none; width: 100%; transition: opacity 0.2s; }
			.btn-submit { background: #fff; color: #6a11cb; margin-top: 5px; }
			.btn-logout { background: rgba(255, 255, 255, 0.15); color: #fff; margin-top: 15px; border: 1px solid rgba(255, 255, 255, 0.2); }
			button:hover { opacity: 0.9; }
		</style>
	</head>	

	<body>
		<div class="dashboard-card">
			<!-- 🌟 Dynamic Avatar Display Window -->
			<div class="avatar-container">
				<img src={avatarUrl} alt="Avatar" class="avatar-preview" id="avatarImage" />
			</div>

			<h1>Welcome, {greetingName}! 👋</h1>
			<p>Your full security profile control station.</p>
			
			<!-- 🌟 PROFILE INFO FORM WITH MULTIPART FOR FILES -->
			<div class="form-box">
				<h3>Edit Profile Info</h3>
				<form id="profileForm" enctype="multipart/form-data">
					<label for="avatarFile">Upload New Avatar Photo</label>
					<input type="file" id="avatarFile" name="avatarFile" accept="image/*" />

					<label for="displayName">Display Name</label>
					<input type="text" id="displayName" name="displayName" value={displayName} placeholder="Choose a public display name" />

					<label for="address">Location Address</label>
					<input type="text" id="address" name="address" value={address} placeholder="City, Country" />

					<label for="bio">About Me (Bio)</label>
					<textarea id="bio" name="bio" placeholder="Write a short summary about yourself...">{bio}</textarea>

					<button type="submit" class="btn-submit">Save Profile Changes</button>
				</form>
			</div>

			<!-- Place this inside the dashboard-card right below your Profile Form block -->
<div class="form-box" style="margin-top: 25px; padding-top: 25px; border-top: 1px solid rgba(255, 75, 92, 0.3);">
    <h3 style="color: #ff4b5c; text-align: center; margin-top: 0; margin-bottom: 10px;">Danger Zone</h3>
    <p style="font-size: 13px; color: rgba(255, 255, 255, 0.7); text-align: center; margin-bottom: 15px;">
        Deleting your account is permanent. All your data and files will be wiped completely.
    </p>
    <button id="deleteAccountBtn" style="background: #ff4b5c; color: #fff;">Delete Account Permanently</button>
</div>
			<!-- Log Out Button Trigger -->
			<form action="/logout-api" method="POST">
				<button type="submit" class="btn-logout">Log Out</button>
			</form>
		</div>

		<script>
			const profileForm = document.getElementById("profileForm") as HTMLFormElement | null;
			const avatarFile = document.getElementById("avatarFile") as HTMLInputElement | null;
			const avatarImage = document.getElementById("avatarImage") as HTMLImageElement | null;

			// Optional UX: Show instant local picture preview when user chooses a file
			avatarFile?.addEventListener("change", () => {
				if (avatarFile?.files && avatarFile.files[0] && avatarImage) {
					avatarImage.src = URL.createObjectURL(avatarFile.files[0]);
				}
			});

			profileForm?.addEventListener("submit", async (event) => {
				event.preventDefault();
				if (!profileForm) return;

				const formData = new FormData(profileForm);

				try {
					const response = await fetch('/profile-api', {
						method: 'POST',
						body: formData
					});

					const data = await response.json();
					alert(data.message);
					
					if (data.success) {
						window.location.reload(); 
					}
				} catch (error) {
					alert("Failed to communicate with profile update gateway.");
				}
			});

			// Add this inside the script tag of src/pages/dashboard.astro
const deleteAccountBtn = document.getElementById("deleteAccountBtn");

deleteAccountBtn?.addEventListener("click", async () => {
    // 🌟 Double confirmation pattern to protect user accounts from accidental misclicks
    const firstConfirm = confirm("Are you absolutely sure you want to delete your account? This action cannot be undone.");
    if (!firstConfirm) return;

    const secondConfirm = confirm("FINAL WARNING: This will completely remove your profile data and delete your custom upload files from our server database. Proceed?");
    if (!secondConfirm) return;

    try {
        const response = await fetch('/delete-account-api', {
            method: 'POST'
        });

        const data = await response.json();
        alert(data.message);

        if (data.success) {
            window.location.href = '/'; // Send them back to the clean entrance form on success
        }
    } catch (error) {
        alert("Failed to communicate with the account destruction gateway.");
    }
});

		</script>
	</body>
</html>

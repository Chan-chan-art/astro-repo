	max-width: 100%;
	max-height: 280px;
	margin-top: 15px;
	padding: 12px;
	border: 1px solid rgba(255, 255, 255, 0.06);
	display: flex;
	flex-direction: column;
}

.comment-list-feed {
	min-height: 0;
	max-height: 170px;
	flex: 1 1 auto;
	width: 100%;
	min-width: 0;
	overflow-y: auto;
	margin-bottom: 10px;
	display: flex;
	flex-direction: column;
	gap: 6px;
	padding-right: 4px;
	overscroll-behavior: contain;
	scrollbar-width: thin;
	scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
}

.comment-list-feed::-webkit-scrollbar {
	width: 6px;
}

.comment-list-feed::-webkit-scrollbar-thumb {
	background: rgba(255, 255, 255, 0.35);
	border-radius: 6px;
}

.comment-empty-state {
	padding: 10px 4px;
	color: var(--dashboard-muted);
	font-size: 11px;
	text-align: center;
}

/* Individual micro-chat message bubble boxes */
.comment-bubble {
	align-self: flex-start;
	width: fit-content;
	max-width: 100%;
	min-width: 0;
	box-sizing: border-box;
	background: rgba(255, 255, 255, 0.06);
	padding: 6px 10px;
	border-radius: 8px;
	font-size: 12px;
	line-height: 1.4;
	overflow-wrap: anywhere;
}

.comment-bubble-meta {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 10px;
	min-width: 0;
	margin-bottom: 4px;
	font-size: 10px;
	color: rgba(255, 255, 255, 0.45);
}

.comment-bubble-meta strong,
.comment-bubble-meta span {
	min-width: 0;
	overflow-wrap: anywhere;
}

.comment-bubble-meta strong {
	flex: 1 1 auto;
}

.comment-bubble-meta span {
	flex: 0 1 auto;
	text-align: right;
}

.comment-bubble-text {
	color: rgba(255, 255, 255, 0.95);
	white-space: pre-wrap;
	overflow-wrap: anywhere;
}

.comment-attachment-list {
	display: flex;
	flex-wrap: wrap;
	align-items: flex-start;
	max-width: 100%;
	gap: 6px;
	margin-top: 6px;
}

.comment-attachment-list > * {
	min-width: 0;
	max-width: 100%;
}

.comment-image-attachment .attachment-preview-open {
	display: grid;
	flex: 0 1 120px;
	width: min(120px, 100%);
	max-width: 100%;
	height: 88px;
	min-width: 0;
	box-sizing: border-box;
}

.comment-image-attachment {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	min-width: 0;
	width: min(120px, 100%);
	max-width: 100%;
}

.comment-image-attachment .comment-attachment-download {
	max-width: 100%;
	color: #e2d5ff;
	font-size: 10px;
	overflow-wrap: anywhere;
}

.comment-location-link {
	display: block;
	max-width: 100%;
	color: #d7c5ff;
	font-size: 11px;
	overflow-wrap: anywhere;
}

.comment-attachment-link {
	display: inline-grid;
	flex: 0 0 30px;
	place-items: center;
	width: 30px;
	height: 30px;
	border: 1px solid rgba(255, 255, 255, 0.16);
	border-radius: 9px;
	background: rgba(255, 255, 255, 0.1);
	color: #fff;
	text-decoration: none;
	font-size: 15px;
	box-sizing: border-box;
}

.comment-attachment-link:hover,
.comment-attachment-link:focus-visible {
	background: rgba(255, 255, 255, 0.25);
	outline: 2px solid rgba(255, 255, 255, 0.65);
	outline-offset: 2px;
}

.comment-input-box-row {
	display: flex;
	align-items: center;
	gap: 6px;
	width: 100%;
	min-width: 0;
	max-width: 100%;
	box-sizing: border-box;
}

.chat-composer-field {
	position: relative;
	display: flex;
	align-items: center;
	flex: 1 1 0;
	width: 0;
	min-width: 0;
	height: 36px;
	padding: 2px 4px;
	border: 1px solid rgba(255, 255, 255, 0.16);
	border-radius: 12px;
	background: rgba(255, 255, 255, 0.1);
	box-sizing: border-box;
}

.chat-composer-field input[name="text"] {
	display: block;
	flex: 1 1 0;
	width: 0 !important;
	min-width: 0;
	height: 30px;
	margin: 0 !important;
	padding: 6px 8px !important;
	border: 0;
	border-radius: 8px !important;
	background: transparent;
	font-size: 12px !important;
}

.chat-composer-field input[name="text"]:focus {
	background: transparent;
}

.chat-composer-field .chat-attachment-toggle {
	flex: 0 0 30px;
	width: 30px !important;
	height: 30px !important;
	padding: 0 !important;
	border: 0 !important;
	border-radius: 50% !important;
	background: transparent !important;
	color: #fff !important;
	font-size: 22px !important;
	line-height: 1;
	transition: transform 0.2s ease, background-color 0.2s ease;
}

.chat-attachment-toggle[aria-expanded="true"] {
	transform: rotate(45deg);
	background: rgba(255, 255, 255, 0.18) !important;
}

.chat-attachment-actions {
	position: absolute;
	z-index: 3;
	left: 0;
	bottom: 42px;
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	width: min(176px, 100%);
	gap: 6px;
	padding: 8px;
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 12px;
	background: rgba(38, 22, 79, 0.97);
	box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
	box-sizing: border-box;
}

.chat-attachment-actions[hidden] {
	display: none;
}

.chat-composer-field .chat-attachment-icon {
	display: grid;
	place-items: center;
	width: 100% !important;
	min-width: 0;
	height: 36px !important;
	padding: 0 !important;
	border: 1px solid rgba(255, 255, 255, 0.15);
	border-radius: 9px;
	background: rgba(255, 255, 255, 0.1);
	color: #fff;
	font-size: 17px;
}

.chat-attachment-icon svg {
	display: block;
	width: 18px;
	height: 18px;
}

.chat-attachment-icon:hover,
.chat-attachment-icon:focus-visible {
	background: rgba(255, 255, 255, 0.25);
	outline: 2px solid rgba(255, 255, 255, 0.65);
	outline-offset: 1px;
}

.chat-attachment-input {
	display: none !important;
}

.chat-attachment-status {
	position: absolute;
	left: 0;
	bottom: 42px;
	z-index: 2;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 6px;
	width: min(250px, 100%);
	max-width: 100%;
	max-height: 180px;
	overflow: auto;
	padding: 6px 9px;
	border-radius: 8px;
	background: rgba(38, 22, 79, 0.97);
	color: rgba(255, 255, 255, 0.9);
	font-size: 11px;
	overflow-wrap: anywhere;
	box-sizing: border-box;
}

.chat-attachment-status[hidden] {
	display: none;
}

.comment-input-box-row button {
	flex: 0 0 68px;
	width: 68px !important;
	padding: 0 14px !important;
	font-size: 12px !important;
	height: 36px;
	border-radius: 10px !important;
	background: #ffffff;
	color: #6a11cb;
}
.btn-comment-toggle {
	width: 78px;
	font-size: 9px;
	text-transform: uppercase;
}
.btn-comment-toggle:hover {
	background: rgba(255, 255, 255, 0.2) !important;
	color: #fff !important;
}

/* Dashboard theme preferences */
.settings-panel {
	margin-top: 20px;
	padding: 14px 0 0;
	border: 0;
	border-top: 1px solid var(--dashboard-border);
	border-radius: 0;
	background: transparent;
	text-align: left;
}

.settings-panel h2 {
	margin: 0 0 8px;
	font-size: 13px;
}

.theme-toggle-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin-top: 0;
	padding: 7px 2px 12px;
	color: var(--dashboard-text);
	font-size: 12px;
	cursor: pointer;
}

.theme-toggle-row input {
	width: 18px;
	height: 18px;
	margin: 0;
	accent-color: #9b7cf6;
	cursor: pointer;
}

:root[data-theme="dark"] {
	color-scheme: dark;
	--dashboard-background: linear-gradient(135deg, #17132a 0%, #192447 55%, #202c5c 100%);
	--dashboard-text: #f5f3ff;
	--dashboard-surface: rgba(25, 23, 48, 0.78);
	--dashboard-surface-soft: rgba(255, 255, 255, 0.055);
	--dashboard-surface-hover: rgba(255, 255, 255, 0.11);
	--dashboard-border: rgba(196, 181, 253, 0.2);
	--dashboard-muted: rgba(235, 231, 255, 0.72);
	--dashboard-input-background: rgba(9, 12, 30, 0.42);
	--dashboard-input-text: #f5f3ff;
}

:root[data-theme="dark"] .glass-card {
	box-shadow: 0 8px 32px rgba(4, 7, 24, 0.42);
}

:root[data-theme="dark"] .add-note-form,
:root[data-theme="dark"] .note-item,
:root[data-theme="dark"] .dashboard-stat-card,
:root[data-theme="dark"] .note-skeleton,
:root[data-theme="dark"] .comment-bubble,
:root[data-theme="dark"] .chat-composer-field {
	background-color: var(--dashboard-surface-soft);
	border-color: var(--dashboard-border);
}

:root[data-theme="dark"] .form-group input,
:root[data-theme="dark"] .form-group textarea,
:root[data-theme="dark"] .search-wrapper input,
:root[data-theme="dark"] .select-category,
:root[data-theme="dark"] .note-edit-form input,
:root[data-theme="dark"] .note-edit-form textarea,
:root[data-theme="dark"] .note-edit-form select,
:root[data-theme="dark"] .note-share-form input {
	background-color: var(--dashboard-input-background);
	border-color: var(--dashboard-border);
	color: var(--dashboard-input-text);
}

:root[data-theme="dark"] input::placeholder,
:root[data-theme="dark"] textarea::placeholder {
	color: rgba(235, 231, 255, 0.58);
}

:root[data-theme="dark"] .select-category option,
:root[data-theme="dark"] .note-edit-form select option {
	background: #211b36;
	color: #f5f3ff;
}

:root[data-theme="dark"] .tab-btn,
:root[data-theme="dark"] .note-card-actions button,
:root[data-theme="dark"] .note-attachment-controls button,
:root[data-theme="dark"] .note-dialog button,
:root[data-theme="dark"] .note-share-form button,
:root[data-theme="dark"] .btn-clear-profile,
:root[data-theme="dark"] .btn-share-note {
	border-color: var(--dashboard-border);
	background-color: var(--dashboard-surface-soft);
	color: var(--dashboard-text);
}

:root[data-theme="dark"] .tab-btn:hover,
:root[data-theme="dark"] .note-card-actions button:hover,
:root[data-theme="dark"] .note-attachment-controls button:hover,
:root[data-theme="dark"] .note-dialog button:hover {
	background-color: var(--dashboard-surface-hover);
}

:root[data-theme="dark"] .tab-btn.active,
:root[data-theme="dark"] .btn-submit,
:root[data-theme="dark"] .btn-add-note,
:root[data-theme="dark"] .comment-input-box-row button {
	border-color: #c4b5fd;
	background: #c4b5fd;
	color: #21143b;
}

:root[data-theme="dark"] .note-dialog {
	border-color: var(--dashboard-border);
	background: #211b36;
	color: var(--dashboard-text);
}

:root[data-theme="dark"] .btn-edit-profile {
	border-color: var(--dashboard-border);
	background: var(--dashboard-surface-soft);
	color: var(--dashboard-text);
}

:root[data-theme="dark"] .image-preview-dialog {
	border-color: var(--dashboard-border);
	background: #17132a;
	color: var(--dashboard-text);
}

:root[data-theme="dark"] .note-date,
:root[data-theme="dark"] .dashboard-stat-card span,
:root[data-theme="dark"] .note-attachment-status,
:root[data-theme="dark"] .note-dialog-date,
:root[data-theme="dark"] .note-edit-form label,
:root[data-theme="dark"] .settings-panel > label,
:root[data-theme="dark"] .note-activity {
	color: var(--dashboard-muted);
}

:root[data-theme="dark"] .note-attachment-remove {
	border-color: rgba(248, 113, 113, 0.3);
	background: rgba(248, 113, 113, 0.12);
	color: #fca5a5;
}

:root[data-theme="dark"] .note-attachment-remove:hover {
	border-color: rgba(252, 165, 165, 0.65);
	background: rgba(248, 113, 113, 0.22);
	color: #fee2e2;
}

.dashboard-productivity {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
	gap: 14px;
	margin-top: 18px;
}

.dashboard-productivity[hidden],
#notesViewControls[hidden] {
	display: none;
}

.dashboard-utility-card {
	min-width: 0;
	padding: 16px;
	border: 1px solid var(--dashboard-border);
	border-radius: 18px;
	background: var(--dashboard-surface-soft);
}

.dashboard-utility-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-bottom: 12px;
}

.dashboard-utility-header h3 {
	margin: 0;
	font-size: 15px;
}

.dashboard-utility-header a,
.upcoming-reminder-link {
	color: #e2d5ff;
	font-size: 11px;
	text-decoration: none;
}

.mini-calendar-grid {
	display: grid;
	grid-template-columns: repeat(7, minmax(0, 1fr));
	gap: 3px;
}

.mini-calendar-weekday,
.mini-calendar-day {
	display: grid;
	place-items: center;
	min-width: 0;
	aspect-ratio: 1;
	border-radius: 8px;
	font-size: 10px;
}

.mini-calendar-weekday {
	color: var(--dashboard-muted);
	font-weight: 700;
}

.mini-calendar-day {
	position: relative;
	color: var(--dashboard-text);
	text-decoration: none;
}

.mini-calendar-day.outside-month {
	opacity: 0.35;
}

.mini-calendar-day.today {
	background: #fff;
	color: #6a11cb;
	font-weight: 700;
}

.mini-calendar-day.has-reminders::after {
	position: absolute;
	right: 3px;
	bottom: 3px;
	width: 4px;
	height: 4px;
	border-radius: 50%;
	background: #a1c4fd;
	content: "";
}

.mini-calendar-day:hover {
	background: var(--dashboard-surface-hover);
}

.mini-calendar-day.today:hover {
	background: #fff;
	color: #6a11cb;
}

.upcoming-reminder-list {
	display: grid;
	gap: 8px;
	margin: 0;
	padding: 0;
	list-style: none;
}

.upcoming-reminder-item {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 8px;
	padding: 9px 10px;
	border: 1px solid var(--dashboard-border);
	border-radius: 11px;
	background: var(--dashboard-surface-soft);
}

.upcoming-reminder-item strong,
.upcoming-reminder-item time {
	display: block;
	font-size: 11px;
}

.upcoming-reminder-item time,
.upcoming-reminder-empty {
	margin-top: 3px;
	color: var(--dashboard-muted);
	font-size: 10px;
}

.upcoming-reminder-empty {
	margin: 0;
}

:root[data-theme="dark"] .dashboard-utility-card,
:root[data-theme="dark"] .upcoming-reminder-item {
	background: var(--dashboard-surface-soft);
	border-color: var(--dashboard-border);
}

:root[data-theme="dark"] .dashboard-utility-header a,
:root[data-theme="dark"] .upcoming-reminder-link {
	color: #c4b5fd;
}

		</style>
		<script is:inline>
			(() => {
				const storageKey = "notepad-theme-preference";
				const validPreferences = ["light", "dark", "system"];
				let preference = "system";

				try {
					const storedPreference = localStorage.getItem(storageKey);
					if (storedPreference && validPreferences.includes(storedPreference)) {
						preference = storedPreference;
					}
				} catch (error) {
					console.error("Unable to read the saved theme preference.", error);
				}

				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.dataset.themePreference = preference;
				document.documentElement.dataset.theme =
					preference === "system" ? (prefersDark ? "dark" : "light") : preference;
			})();
		</script>
	</head>	

		
<body>
		<!-- 🌟 Main Dynamic Grid Canvas Layout Wrapper -->
		<div class="dashboard-container">
			
			<!-- LEFT SIDEBAR: PROFILE & CONTROLS -->
			<div class="glass-card profile-card" data-user-id={userId}>
				<img src={avatarUrl} alt="Avatar" class="avatar-preview" />
				<h1 style="font-size:22px; margin: 10px 0 2px 0;">{greetingName}</h1>
				<p style="font-size:12px; margin-bottom:15px;">Profile Station</p>
				<button type="button" class="btn-edit-profile" id="openProfileDialog" aria-haspopup="dialog" aria-controls="profileSettingsDialog">Edit Profile</button>
				<WorkspaceNavigation
					currentPage="dashboard"
					currentSection={viewMode === "dashboard" ? undefined : viewMode}
					showPreferences={false}
					showLogout={false}
				/>
				
				<section class="settings-panel" aria-labelledby="dashboardPreferencesHeading">
					<h2 id="dashboardPreferencesHeading">Preferences</h2>
					<label class="theme-toggle-row" for="darkModeToggle">
						<span>Dark Mode</span>
						<input type="checkbox" id="darkModeToggle" />
					</label>
				</section>
				
				<!-- Separate Secure Logout Action -->
				<form action="/logout-api" method="POST">
					<button type="submit" class="btn-logout">Log Out</button>
				</form>
			</div>

			<dialog id="profileSettingsDialog" class="note-dialog profile-settings-dialog" aria-labelledby="profileSettingsHeading">
				<div class="note-dialog-content">
					<div class="note-dialog-header">
						<h2 id="profileSettingsHeading">Edit Profile</h2>
						<button type="button" class="profile-dialog-close" data-close-note-dialog aria-label="Close profile settings">Close</button>
					</div>
					<div class="form-box profile-form-box" style="text-align: left;">
						<form id="profileForm" enctype="multipart/form-data">
							<input type="hidden" id="compressedAvatarString" name="compressedAvatarString" value="" />
							<div class="form-group" style="margin-bottom: 12px;">
								<label for="avatarFileInput">Avatar Photo</label>
								<input
									type="file"
									id="avatarFileInput"
									name="avatarFile"
									accept="image/*"
									style="background:transparent; font-size:11px;"
								/>
							</div>

							<div class="form-group" style="margin-bottom: 12px;">
								<label for="profileDisplayName">
									Display Name
									<span class="char-counter" id="displayNameCounter">(0 / 50)</span>
								</label>
								<input
									type="text"
									id="profileDisplayName"
									name="displayName"
									value={displayName}
									maxlength="50"
								/>
							</div>

							<div class="form-group" style="margin-bottom: 12px;">
								<label for="profileLocation">Location</label>
								<input
									type="text"
									id="profileLocation"
									name="address"
									value={address}
								/>
							</div>

							<div class="form-group" style="margin-bottom: 12px;">
								<label for="profileBio">
									Bio
									<span class="char-counter" id="bioCounter">(0 / 250)</span>
								</label>
								<textarea id="profileBio" name="bio" maxlength="250" placeholder="Tell us about yourself...">{bio}</textarea>
							</div>

							<div style="display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-top: 15px;">
								<button type="submit" class="btn-submit" style="margin: 0;">Save Profile</button>
								<button type="button" id="clearProfileBtn" class="btn-clear-profile" title="Wipe form fields" style="margin: 0; padding: 0 15px;">Wipe</button>
							</div>
						</form>
					</div>
				</div>
			</dialog>

			<!-- RIGHT WORKSPACE: INTERACTIVE WORKSPACE NOTEPAD -->
			<div class="glass-card workspace-content" data-view-mode={viewMode}>
				<h2 style="margin-top:0; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom:10px;">📋 Personal Notepad Workspace</h2>
				<h3 class="workspace-view-title">
					{viewMode === "notes" ? "My Notes" : viewMode === "favorites" ? "Favorites" : viewMode === "pinned" ? "Pinned Notes" : viewMode === "trash" ? "Trash" : "Dashboard"}
				</h3>
			{viewMode !== "trash" && (
			<div class="dashboard-statistics" aria-label="Dashboard note statistics">
				<div class="dashboard-stat-card"><strong data-note-stat="total">{noteStatistics.total}</strong><span>Total Notes</span></div>
				<div class="dashboard-stat-card"><strong data-note-stat="general">{noteStatistics.general}</strong><span>General</span></div>
				<div class="dashboard-stat-card"><strong data-note-stat="work">{noteStatistics.work}</strong><span>Work</span></div>
				<div class="dashboard-stat-card"><strong data-note-stat="personal">{noteStatistics.personal}</strong><span>Personal</span></div>
				<div class="dashboard-stat-card"><strong data-note-stat="ideas">{noteStatistics.ideas}</strong><span>Ideas</span></div>
			</div>
			)}

			{viewMode === "dashboard" && (
			<div class="dashboard-productivity" id="dashboardProductivity">
				<section class="dashboard-utility-card" aria-labelledby="miniCalendarHeading">
					<div class="dashboard-utility-header">
						<h3 id="miniCalendarHeading">Mini Calendar</h3>
						<a href="/calendar">Full Calendar</a>
					</div>
					<div class="mini-calendar-grid" aria-label={`${miniCalendarMonth.toLocaleString("en", { month: "long", year: "numeric" })} mini calendar`}>
						{["S", "M", "T", "W", "T", "F", "S"].map((weekday) => (
							<span class="mini-calendar-weekday" aria-hidden="true">{weekday}</span>
						))}
						{miniCalendarDates.map((day) => (
							<a
								href={`/calendar?date=${day.dateKey}`}
								class:list={["mini-calendar-day", { "outside-month": !day.inMonth, today: day.isToday, "has-reminders": day.hasReminder }]}
								aria-label={`${day.date.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric" })}${day.hasReminder ? ", has reminders" : ""}`}
							>
								{day.date.getDate()}
							</a>
						))}
					</div>
				</section>


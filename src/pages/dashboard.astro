	async function updateNotePreference(button: HTMLButtonElement) {
		const card = getNoteCard(button);
		const noteId = button.dataset.id;
		const preference = button.dataset.preference;
		if (!card || !noteId || (preference !== "pinned" && preference !== "favorite")) return;

		const wasEnabled = card.dataset[preference] === "true";
		const enabled = !wasEnabled;
		button.disabled = true;
		try {
			const response = await fetch(`/note-preferences-api?noteId=${encodeURIComponent(noteId)}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ preference, enabled })
			});
			const data = await response.json();
			if (!response.ok || !data.success) {
				throw new Error(data.message || "Unable to save this note preference.");
			}

			card.dataset[preference] = String(enabled);
			announceWorkspaceCountChange(preference === "favorite" ? "favorites" : "pinned", enabled ? 1 : -1);
			button.setAttribute("aria-pressed", String(enabled));
			button.classList.toggle("is-active", enabled);
			button.textContent = preference === "pinned"
				? (enabled ? "📌 Unpin" : "📌 Pin")
				: (enabled ? "★ Remove Favorite" : "☆ Favorite");
			if (preference === "pinned") sortNoteCards();
			updateWorkspaceVisibility();
			showNotificationToast(preference === "pinned"
				? (enabled ? "Note pinned." : "Note unpinned.")
				: (enabled ? "Added to Favorites." : "Removed from Favorites."));
		} catch (error) {
			console.error("Unable to update note preference.", error);
			showNotificationToast(error instanceof Error ? error.message : "Unable to save this note preference.", true);
		} finally {
			button.disabled = false;
		}
	}

	async function updateNoteCardReminder(button: HTMLButtonElement) {
		const reminderCard = button.closest<HTMLElement>("[data-note-reminder]");
		const reminderId = reminderCard?.dataset.reminderId;
		const action = button.dataset.reminderAction;
		const dueDate = reminderCard?.dataset.dueDate;
		if (!reminderCard || !reminderId || !dueDate || (action !== "complete" && action !== "snooze")) return;

		button.disabled = true;
		try {
			const response = await fetch(`/reminders-api?id=${encodeURIComponent(reminderId)}`, {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(action === "complete" ? { completed: true } : { snoozeMinutes: 60 })
			});
			const data = await response.json();
			if (!response.ok || !data.success) {
				throw new Error(data.message || "Unable to update this reminder.");
			}

			if (action === "complete") {
				if (dueDate === localDateKey()) announceWorkspaceCountChange("remindersToday", -1);
				const list = reminderCard.closest(".note-reminder-list");
				reminderCard.remove();
				if (list?.childElementCount === 0) list.remove();
				showNotificationToast("Reminder completed.");
			} else {
				if (typeof data.date !== "string" || typeof data.time !== "string") {
					throw new Error("The reminder was snoozed, but its updated schedule could not be loaded.");
				}
				if (dueDate === localDateKey() && data.date !== localDateKey()) {
					announceWorkspaceCountChange("remindersToday", -1);
				} else if (dueDate !== localDateKey() && data.date === localDateKey()) {
					announceWorkspaceCountChange("remindersToday", 1);
				}
				reminderCard.dataset.dueDate = data.date;
				const duePill = reminderCard.querySelector<HTMLTimeElement>(".note-reminder-due-pill");
				if (duePill) {
					duePill.dataset.dueDate = data.date;
					duePill.dataset.dueTime = data.time;
					duePill.dateTime = `${data.date}T${data.time}`;
				}
				updateNoteReminderDuePills();
				showNotificationToast("Reminder snoozed for one hour.");
			}
		} catch (error) {
			console.error("Note card reminder update error.", error);
			showNotificationToast(error instanceof Error ? error.message : "Unable to update this reminder.", true);
		} finally {
			button.disabled = false;
		}
	}


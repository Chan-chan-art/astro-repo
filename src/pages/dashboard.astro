		setTimeout(updateNoteAttachmentStatus, 0);
	});

	// ==========================================
	// 3. UNIFIED COMBINED SEARCH/FILTER SYSTEM
	// ==========================================
	const workspaceFilterAnimations = new WeakMap<HTMLElement, Animation>();
	let workspaceFilterUpdateId = 0;

	function animateWorkspaceCard(card: HTMLElement, keyframes: Keyframe[], duration = 160) {
		const animation = card.animate(keyframes, {
			duration,
			easing: "cubic-bezier(0.2, 0.7, 0.2, 1)",
			fill: "both"
		});
		workspaceFilterAnimations.set(card, animation);
		animation.onfinish = () => {
			if (workspaceFilterAnimations.get(card) !== animation) return;
			workspaceFilterAnimations.delete(card);
			animation.cancel();
		};
	}

	function updateWorkspaceVisibility(animate = false) {
		const updateId = ++workspaceFilterUpdateId;
		const searchQuery = workspaceSearch?.value.toLowerCase().trim() || "";
		const noteCards = Array.from(document.querySelectorAll<HTMLElement>(".notes-grid .note-item"));
		const canAnimate = animate &&
			!document.hidden &&
			!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
			typeof Element.prototype.animate === "function";
		const firstPositions = new Map<HTMLElement, DOMRect>();
		const matchingCards: HTMLElement[] = [];
		const targets = new Map<HTMLElement, boolean>();
		let matchingCardCount = 0;

		noteCards.forEach((card) => {
			const runningAnimation = workspaceFilterAnimations.get(card);
			if (runningAnimation) {
				runningAnimation.cancel();
				workspaceFilterAnimations.delete(card);
			}

			const titleText = card.querySelector("h4")?.textContent?.toLowerCase() || "";
			const contentText = card.querySelector("p")?.textContent?.toLowerCase() || "";
			const cardCategory = card.getAttribute("data-category") || "General";

			const matchesSearch = titleText.includes(searchQuery) || contentText.includes(searchQuery);
			const noteCard = card as HTMLElement;
			const matchesView = workspaceViewMode === "favorites"
				? noteCard.dataset.favorite === "true"
				: workspaceViewMode === "pinned"
					? noteCard.dataset.pinned === "true"
					: true;
			const matchesTab = activeCategoryFilter === "all"
				? true
				: activeCategoryFilter === "favorites"
					? noteCard.dataset.favorite === "true"
					: activeCategoryFilter === "pinned"
						? noteCard.dataset.pinned === "true"
						: cardCategory === activeCategoryFilter;

			const matches = matchesSearch && matchesView && matchesTab;
			targets.set(noteCard, matches);
			if (matches) {
				matchingCards.push(noteCard);
				matchingCardCount++;
			}
		});

		let noResultsMsg = document.getElementById("noSearchResultsMessage");
		if (matchingCardCount === 0 && noteCards.length > 0) {
			if (!noResultsMsg) {
				document.querySelector(".notes-grid")?.insertAdjacentHTML("beforeend", `
					<div id="noSearchResultsMessage" style="grid-column: 1 / -1; text-align:center; color:rgba(255,255,255,0.4); padding: 40px 20px;">
						🔍 No notes match your active filter metrics.
					</div>
				`);
			}
		} else {
			noResultsMsg?.remove();
		}

		noteCards.forEach((card) => {
			if (!card.classList.contains("filtered-out")) {
				firstPositions.set(card, card.getBoundingClientRect());
			}
		});

		const enteringCards = noteCards.filter((card) =>
			targets.get(card) && card.classList.contains("filtered-out")
		);
		const exitingCards = noteCards.filter((card) =>
			!targets.get(card) && !card.classList.contains("filtered-out")
		);

		if (!canAnimate) {
			noteCards.forEach((card) => {
				card.classList.toggle("filtered-out", !targets.get(card));
			});
		} else {
			enteringCards.forEach((card) => card.classList.remove("filtered-out"));
			enteringCards.forEach((card) => {
				animateWorkspaceCard(card, [
					{ opacity: 0, transform: "translateY(10px) scale(0.98)" },
					{ opacity: 1, transform: "translateY(0) scale(1)" }
				]);
			});

			notesGrid?.getBoundingClientRect();
			firstPositions.forEach((firstPosition, card) => {
				if (!targets.get(card)) return;
				const lastPosition = card.getBoundingClientRect();
				const deltaX = firstPosition.left - lastPosition.left;
				const deltaY = firstPosition.top - lastPosition.top;
				if (Math.abs(deltaX) < 1 && Math.abs(deltaY) < 1) return;
				animateWorkspaceCard(card, [
					{ opacity: 0.8, transform: `translate(${deltaX}px, ${deltaY}px)` },
					{ opacity: 1, transform: "translate(0, 0)" }
				]);
			});

			let remainingExits = exitingCards.length;
			const finishExit = (card: HTMLElement, animation: Animation) => {
				if (
					updateId !== workspaceFilterUpdateId ||
					workspaceFilterAnimations.get(card) !== animation
				) return;
				remainingExits--;
				if (remainingExits > 0) return;

				const positionsBeforeRemoval = new Map<HTMLElement, DOMRect>();
				matchingCards.forEach((matchingCard) => {
					positionsBeforeRemoval.set(matchingCard, matchingCard.getBoundingClientRect());
				});
				exitingCards.forEach((exitingCard) => exitingCard.classList.add("filtered-out"));
				notesGrid?.getBoundingClientRect();
				exitingCards.forEach((exitingCard) => {
					const exitAnimation = workspaceFilterAnimations.get(exitingCard);
					if (exitAnimation) {
						workspaceFilterAnimations.delete(exitingCard);
						exitAnimation.cancel();
					}
				});
				positionsBeforeRemoval.forEach((firstPosition, matchingCard) => {
					const lastPosition = matchingCard.getBoundingClientRect();
					const deltaX = firstPosition.left - lastPosition.left;
					const deltaY = firstPosition.top - lastPosition.top;
					if (Math.abs(deltaX) < 1 && Math.abs(deltaY) < 1) return;
					animateWorkspaceCard(matchingCard, [
						{ opacity: 0.8, transform: `translate(${deltaX}px, ${deltaY}px)` },
						{ opacity: 1, transform: "translate(0, 0)" }
					]);
				});
			};

			exitingCards.forEach((card) => {
				const animation = card.animate([
					{ opacity: 1, transform: "translateY(0) scale(1)" },
					{ opacity: 0, transform: "translateY(-8px) scale(0.98)" }
				], {
					duration: 190,
					easing: "cubic-bezier(0.2, 0.7, 0.2, 1)",
					fill: "both"
				});
				workspaceFilterAnimations.set(card, animation);
				animation.onfinish = () => finishExit(card, animation);
			});
		}

	}

	function applyDashboardHashRoute(animate = false) {
		const section = window.location.hash.slice(1).toLowerCase();
		if (section === "notes" || section === "favorites" || section === "pinned") {
			workspaceViewMode = "dashboard";
			activeCategoryFilter = section === "notes" ? "all" : section;
			const notesViewControls = document.getElementById("notesViewControls");
			const dashboardProductivity = document.getElementById("dashboardProductivity");
			if (notesViewControls) notesViewControls.hidden = false;
			if (dashboardProductivity) dashboardProductivity.hidden = true;
			const viewTitle = document.querySelector<HTMLElement>(".workspace-view-title");
			if (viewTitle) viewTitle.textContent = section === "notes" ? "My Notes" : section === "favorites" ? "Favorites" : "Pinned Notes";
		} else if (!section) {
			workspaceViewMode = serverViewMode;
			activeCategoryFilter = initialCategoryFilter;
			const notesViewControls = document.getElementById("notesViewControls");
			const dashboardProductivity = document.getElementById("dashboardProductivity");
			if (notesViewControls) notesViewControls.hidden = serverViewMode === "dashboard";
			if (dashboardProductivity) dashboardProductivity.hidden = serverViewMode !== "dashboard";
			const viewTitle = document.querySelector<HTMLElement>(".workspace-view-title");
			if (viewTitle) {
				viewTitle.textContent = serverViewMode === "notes"
					? "My Notes"
					: serverViewMode === "favorites"
						? "Favorites"
						: serverViewMode === "pinned"
							? "Pinned Notes"
							: serverViewMode === "trash" ? "Trash" : "Dashboard";
			}
		} else {
			return;
		}

		document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((button) => {
			button.classList.toggle("active", button.dataset.filter === activeCategoryFilter);
		});
		updateWorkspaceVisibility(animate);
	}

	window.addEventListener("hashchange", () => applyDashboardHashRoute(true));

	// Connect Event listeners to Tab Switch Buttons
	document.querySelectorAll(".tab-btn").forEach(btn => {
		btn.addEventListener("click", () => {
			document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
			btn.classList.add("active");
			
			activeCategoryFilter = btn.getAttribute("data-filter") || "all";
			updateWorkspaceVisibility(true);
		});
	});

	if (activeCategoryFilter !== "all") {
		document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
			btn.classList.toggle("active", btn.dataset.filter === activeCategoryFilter);
		});
	}
	if (hashViewMode) applyDashboardHashRoute();
	else updateWorkspaceVisibility();

	// Re-route Search Field inputs to call the unified visibility controller
	workspaceSearch?.addEventListener("input", () => {
		if (workspaceSearch.value.length > 0) clearSearchBtn?.classList.add("is-visible");
		else clearSearchBtn?.classList.remove("is-visible");
		updateWorkspaceVisibility(true);
	});

	clearSearchBtn?.addEventListener("click", () => {
		if (workspaceSearch) workspaceSearch.value = "";
		clearSearchBtn?.classList.remove("is-visible");
		workspaceSearch?.focus();
		updateWorkspaceVisibility(true);
	});


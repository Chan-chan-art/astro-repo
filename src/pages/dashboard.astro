---
// src/pages/dashboard.astro
import { pool } from '../lib/db';
export const prerender = false;

const sessionCookie = Astro.cookies.get("user_session");
let sessionData = null; // Only declare sessionData ONCE here

// Safely evaluate the cookie string before parsing it
if (sessionCookie && sessionCookie.value.trim() !== "") {
  try {
    sessionData = sessionCookie.json();
  } catch (e) {
    console.error("Invalid session cookie JSON format structural fault:", e);
    Astro.cookies.delete("user_session"); 
  }
}

// Kick them out if no valid session data is present
if (!sessionData || !sessionData.username) {
  return Astro.redirect('/'); 
}

const username = sessionData.username; // Only declare username ONCE here

let displayName = "";
let bio = "";
let address = "";
let avatarUrl = "/default-avatar.png";
let userNotes: any[] = [];

try {
  // 1. Fetch User Profile
  const [userRows]: any = await pool.execute(
    'SELECT id, display_name, bio, address, avatar_url FROM users WHERE BINARY username = ?',
    [username]
  );
  if (userRows.length === 1) {
    displayName = userRows[0].display_name || "";
    bio = userRows[0].bio || "";
    address = userRows[0].address || "";
    avatarUrl = userRows[0].avatar_url || "/default-avatar.png";
    const userId = userRows[0].id;

    // 2. Fetch only THIS user's private notes
    const [noteRows]: any = await pool.execute(
      'SELECT id, title, content, DATE_FORMAT(created_at, "%b %d, %Y") as date FROM notes WHERE user_id = ? ORDER BY id DESC',
      [userId]
    );
    userNotes = noteRows;
  }
} catch (error) {
  console.error("Dashboard Fetch Error:", error);
}

const greetingName = displayName || username;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Dashboard Portal</title>
		<style>
			body {
				margin: 0;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
				font-family: Arial, sans-serif;
				color: #fff;
				padding: 40px;
				box-sizing: border-box;
			}
			/* 🌟 Expanded Split Grid Layout Wrapper */
			.dashboard-container {
				display: grid;
				grid-template-columns: 1fr 1.5fr; /* Left section smaller, right workspace wider */
				gap: 30px;
				width: 75%;
				max-width: 1200px;
			}
			.glass-card {
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(10px);
				padding: 35px;
				border-radius: 25px;
				box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
				box-sizing: border-box;
			}
			.profile-card { text-align: center; height: fit-content; }
			.avatar-preview { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255, 255, 255, 0.4); }
			
			.form-box { margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.2); }
			label { font-size: 11px; font-weight: bold; display: block; margin-top: 10px; }
			input, textarea {
				width: 100%; padding: 11px; margin: 5px 0 10px 0; border: none; border-radius: 20px;
				background: rgba(255, 255, 255, 0.2); color: #fff; outline: none; box-sizing: border-box; font-family: Arial;
			}
			textarea { border-radius: 15px; resize: none; height: 60px; }
			
			button { padding: 11px; border-radius: 20px; cursor: pointer; font-weight: bold; border: none; width: 100%; }
			.btn-submit { background: #fff; color: #6a11cb; }
			.btn-logout { background: rgba(255, 255, 255, 0.15); color: #fff; margin-top: 15px; border: 1px solid rgba(255, 255, 255, 0.2); }
			
			/* 🌟 Notepad Display Layout */
			.note-item {
				background: rgba(255, 255, 255, 0.15);
				padding: 15px 20px;
				border-radius: 15px;
				margin-top: 15px;
				position: relative;
				border-left: 4px solid #fff;
			}
			.note-item h4 { margin: 0 0 5px 0; font-size: 16px; width: 90%; }
			.note-item p { margin: 0; color: rgba(255, 255, 255, 0.8); font-size: 13px; line-height: 1.4; }
			.note-date { font-size: 10px; color: rgba(255, 255, 255, 0.5); display: block; margin-top: 8px; }
			.btn-delete-note {
				position: absolute; top: 15px; right: 15px; background: transparent; color: rgba(255,255,255,0.6);
				border: none; cursor: pointer; font-size: 14px; width: auto; padding: 0;
			}
			.btn-delete-note:hover { color: #ff4b5c; }
		</style>
	</head>	

	<body>
		<div class="dashboard-container">
			
			<!-- LEFT SIDEBAR: PROFILE & CONTROLS -->
			<div class="glass-card profile-card">
				<img src={avatarUrl} alt="Avatar" class="avatar-preview" />
				<h1 style="font-size:22px; margin: 10px 0 2px 0;">{greetingName}</h1>
				<p style="font-size:12px; margin-bottom:15px;">Profile Station</p>
				
				<div class="form-box" style="text-align: left;">
					<form id="profileForm" enctype="multipart/form-data">
						<label>Avatar Photo</label>
						<input type="file" name="avatarFile" accept="image/*" style="background:transparent; font-size:11px;" />
						<label>Display Name</label>
						<input type="text" name="displayName" value={displayName} />
						<label>Location</label>
						<input type="text" name="address" value={address} />
						<label>Bio</label>
						<textarea name="bio">{bio}</textarea>
						<button type="submit" class="btn-submit">Save Profile</button>
					</form>
				</div>

				<form action="/logout-api" method="POST">
    		<button type="submit" class="btn-logout">Log Out</button>
				</form>
        </div>
			

			<!-- RIGHT SIDEBAR: INTERACTIVE WORKSPACE NOTEPAD -->
			<div class="glass-card">
				<h2 style="margin-top:0; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom:10px;">📋 Personal Notepad Workspace</h2>
				
				<!-- Add Note Sub-Form -->
				<form id="addNoteForm" style="display:grid; grid-template-columns: 1fr 2fr auto; gap: 10px; align-items: end; margin-top:15px;">
					<div>
						<label style="margin-top:0;">Note Title</label>
						<input type="text" id="noteTitle" name="title" placeholder="Meeting..." required style="margin:5px 0 0 0;" />
					</div>
					<div>
						<label style="margin-top:0;">What are you thinking?</label>
						<input type="text" id="noteContent" name="content" placeholder="Remember to review the database records..." required style="margin:5px 0 0 0;" />
					</div>
					<button type="submit" class="btn-submit" style="height:40px; width:90px;">Add Note</button>
				</form>

				<!-- Dynamic Rendered Notes Feed List -->
				<div style="margin-top: 20px; max-height: 400px; overflow-y: auto; padding-right:5px;">
					{userNotes.length === 0 ? (
						<p style="text-align:center; color:rgba(255,255,255,0.5); margin-top:40px;">Your workspace is empty. Type a note above to store it safely!</p>
					) : (
						userNotes.map((note) => (
							<div class="note-item">
								<h4>{note.title}</h4>
								<p>{note.content}</p>
								<span class="note-date">🗓️ Saved on {note.date}</span>
								<button class="btn-delete-note" data-id={note.id}>✕</button>
							</div>
						))
					)}
				</div>
			</div>

		</div>

		<!-- CLIENT SIDE INTERACTIVE CONTROLLERS -->
		<script>
			const profileForm = document.getElementById("profileForm") as HTMLFormElement | null;
			const addNoteForm = document.getElementById("addNoteForm") as HTMLFormElement | null;

			// Handle Note Submission
			addNoteForm?.addEventListener("submit", async (e) => {
				e.preventDefault();
				const formData = new FormData(addNoteForm);
				try {
					const res = await fetch('/notes-api', { method: 'POST', body: formData });
					const data = await res.json();
					if (data.success) window.location.reload();
					else alert(data.message);
				} catch { alert("Error reaching node workspace endpoint."); }
			});

			// Handle Note Removal click tracking
			document.querySelectorAll(".btn-delete-note").forEach(btn => {
				btn.addEventListener("click", async () => {
					const id = btn.getAttribute("data-id");
					if (confirm("Permanently drop this note out of your workspace records?")) {
						try {
							const res = await fetch(`/notes-api?id=${id}`, { method: 'DELETE' });
							const data = await res.json();
							if (data.success) window.location.reload();
						} catch { alert("Error deleting workspace entry."); }
					}
				});
			});

			// Re-use working dynamic profile code block handler 
			profileForm?.addEventListener("submit", async (e) => {

				// ... existing profileForm submit wrapper
				e.preventDefault();
				if (!profileForm) return;

				const formData = new FormData(profileForm);
				try {
					const res = await fetch('/profile-api', { 
						method: 'POST', 
						body: formData 
					});
					const data = await res.json();
					if (data.success) {
						window.location.reload();
					} else {
						alert(data.message || "Failed to update profile settings.");
					}
				} catch (err) { 
					alert("Error reaching the profile workspace endpoint."); 
				}
			}); // End of profileForm event listener
		</script>
	</body>
</html>

				
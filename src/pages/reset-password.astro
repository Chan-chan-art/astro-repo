---
// src/pages/reset-password.astro
import { pool } from '../lib/db';

export const prerender = false;

// 1. Grab the secret token from the browser URL parameter (?token=...)
const token = Astro.url.searchParams.get('token');
let isTokenValid = true;
let message = "";

if (!token) {
  message = "Invalid or missing password reset token.";
} else {
  try {
    // 2. Look up the token in MySQL and check if it's still active (expires > current time)
    const [rows]: any = await pool.execute(
      'SELECT id FROM users WHERE reset_token = ? AND reset_expires > NOW()',
      [token]
    );

    if (rows.length === 1) {
      isTokenValid = true;
    } else {
      message = "This password reset link is invalid or has expired.";
    }
  } catch (error) {
    message = "A database connection error occurred.";
  }
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Reset Password</title>

		<style>
			body {
				margin: 0;
				display: flex;
				justify-content: center;
				align-items: center;
				height: 100vh;
				background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
				font-family: Arial, sans-serif;
			}
			.login {
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(10px);
				padding: 65px;
				border-radius: 25px;
				width: 25%;
				color: #fff;
				text-align: center;
				box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
			}
			input {
				width: 95%;
				padding: 12px;
				margin: 10px 0;
				border: none;
				border-radius: 25px;
				background: rgba(255, 255, 255, 0.2);
				color: #fff;
				outline: none;
			}
			input::placeholder {
				color: rgba(255, 255, 255, 0.7);
			}
			button {
				background: #fff;
				color: #6a11cb;
				padding: 12px 15px;
				border-radius: 25px;
				width: 100%;
				cursor: pointer;
				font-weight: bold;
				margin-top: 10px;
				border: none;
			}
			button:hover {
				opacity: 0.9;
			}
			.error-box {
				background: rgba(255, 0, 0, 0.2);
				padding: 20px;
				border-radius: 15px;
				margin-bottom: 15px;
			}
		</style>
	</head>	

	<body>
		<div class="login">
			<h2>New Password</h2>
			
			{/* If the token is broken or expired, show the error box */}
			{!isTokenValid ? (
				<div class="error-box">
					<p>{message}</p>
					<p><a href="/" style="color:#fff; font-weight:bold;">Back to Login</a></p>
				</div>
			) : (
				/* If the token is valid, show the password update form */
				<form id="resetForm">
					<p style="font-size: 14px; margin-bottom: 20px;">Type a secure new password for your account.</p>
					
					{/* Hidden field to keep track of the token during submission */}
					<input type="hidden" name="token" value={token} />
					<input type="password" id="password" name="password" placeholder="New Password (min 6 chars)" required />

					<button type="submit">Update Password</button>
				</form>
			)}
		</div>

		<script>
			const resetForm = document.getElementById("resetForm") as HTMLFormElement | null;

			resetForm?.addEventListener("submit", async (event) => {
				event.preventDefault();
				if (!resetForm) return;

				const passwordInput = document.getElementById("password") as HTMLInputElement;
				if (passwordInput.value.length < 6) {
					alert("Password must be at least 6 characters long.");
					return;
				}

				const formData = new FormData(resetForm);

				try {
					const response = await fetch('/reset-api', {
						method: 'POST',
						body: formData
					});

					const data = await response.json();
					alert(data.message);

					if (data.success) {
						window.location.href = '/'; // Send back to login page on success
					}
				} catch (error) {
					alert("Failed to reach the reset endpoint.");
				}
			});
		</script>
	</body>
</html>
